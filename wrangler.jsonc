{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "finops-llm",
  "main": "_site/worker.js",
  "compatibility_date": "2026-05-05",
  "observability": {
    "enabled": true
  },
  // AI crawler hits (GEO analytics). Free tier: 10M writes/mo, 90-day retention.
  // Query with the AE SQL API; see docs/AI-CRAWLER-ANALYTICS.md.
  "analytics_engine_datasets": [
    {
      "binding": "AI_HITS",
      "dataset": "finops_ai_crawler_hits"
    }
  ],
  // Live Anthropic pricing cache for /api/pricing (see src/worker.js).
  // Disabled until the KV namespace exists — a placeholder id fails the deploy,
  // and with no binding the worker simply serves PRICING_BASELINE, which is
  // correct, just not self-updating. To enable, run:
  //   npx wrangler kv namespace create finops-llm-pricing
  // then paste the returned id below and uncomment both blocks.
  // "kv_namespaces": [
  //   { "binding": "PRICING", "id": "<paste-id-here>" }
  // ],
  // "triggers": { "crons": ["17 4 * * *"] },
  "build": {
    "command": "npm run build",
    "cwd": ".",
    "watch_dir": "src"
  },
  "assets": {
    "directory": "_site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
