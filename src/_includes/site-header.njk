{% set navUi = articleUi[lang or 'en'] or articleUi.en %}
<a class="site-skip" href="#main-content">{{ navUi.skip }}</a>
<header class="site-header">
  <div class="site-header-inner">
    <a class="site-brand" href="/" aria-label="FinOps LLM home">
      <img class="site-logo" src="/assets/brand/finops-llm-horizontal-light.svg" width="340" height="54" alt="FinOps LLM" />
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="/">{{ navUi.home }}</a>
      <a href="{% if lang in ['de', 'es', 'fr', 'ja', 'pt'] %}/{{ lang }}{% endif %}/research"{% if '/research' in page.url %} aria-current="page"{% endif %}>{{ navUi.research }}</a>
      <a href="/benchmarks">{{ navUi.benchmarks }}</a>
      <a href="/about">{{ navUi.about }}</a>
      <a class="site-audit" href="/book">{{ navUi.auditButton }} &rarr;</a>
    </nav>
  </div>
</header>
