<!DOCTYPE html>
<html lang="{{ lang or 'en' }}">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
{% if head.title %}<title>{{ head.title | safe }}</title>{% endif %}
{% if head.description %}<meta name="description" content="{{ head.description | safe }}" />{% endif %}
{% if head.keywords %}<meta name="keywords" content="{{ head.keywords | safe }}" />{% endif %}
{% if head.robots %}<meta name="robots" content="{{ head.robots | safe }}" />{% endif %}
{% if head.themeColor %}<meta name="theme-color" content="{{ head.themeColor | safe }}" />{% endif %}
{% if head.verification %}<meta name="msvalidate.01" content="{{ head.verification | safe }}" />{% endif %}
{% if head.canonical %}<link rel="canonical" href="{{ head.canonical | safe }}" />{% endif %}
{% for alt in head.hreflang or (page.url | hreflangsFor) %}<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.href | safe }}" />{% endfor %}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
{% if head.openGraph %}{% for tag in head.openGraph %}<meta property="{{ tag.property }}" content="{{ tag.content | safe }}" />{% endfor %}
{% elif head.canonical %}<meta property="og:type" content="{% if '/research/' in head.canonical %}article{% else %}website{% endif %}" />
<meta property="og:site_name" content="FinOps LLM" />
<meta property="og:locale" content="{{ lang or 'en' }}" />
<meta property="og:url" content="{{ head.canonical | safe }}" />
<meta property="og:title" content="{{ head.title | safe }}" />
{% if head.description %}<meta property="og:description" content="{{ head.description | safe }}" />{% endif %}
<meta property="og:image" content="https://finopsllm.com/og.png" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="FinOps LLM" />{% endif %}
{% if head.twitter %}{% for tag in head.twitter %}<meta name="{{ tag.name }}" content="{{ tag.content | safe }}" />{% endfor %}
{% elif head.canonical %}<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ head.title | safe }}" />
{% if head.description %}<meta name="twitter:description" content="{{ head.description | safe }}" />{% endif %}
<meta name="twitter:image" content="https://finopsllm.com/og.png" />{% endif %}
{% for link in head.links %}{% if link.rel == 'preconnect' %}<link rel="{{ link.rel }}" href="{{ link.href | safe }}"{% if link.crossorigin %} crossorigin{% endif %} />{% else %}<link rel="{{ link.rel }}"{% if link.type %} type="{{ link.type }}"{% endif %}{% if link.sizes %} sizes="{{ link.sizes }}"{% endif %}{% if link.title %} title="{{ link.title }}"{% endif %} href="{{ link.href | safe }}" />{% endif %}{% endfor %}
{% if head.fontStylesheet %}<link href="{{ head.fontStylesheet | safe }}" rel="stylesheet" />{% endif %}
{% if head.style %}<style>{{ head.style | safe }}</style>{% endif %}
{% for script in head.scripts %}<script src="{{ script.src | safe }}"{% if script.defer %} defer{% endif %}></script>{% endfor %}
{% for ld in head.jsonLd %}<script type="application/ld+json">
{{ ld | safe }}
</script>{% endfor %}
{% for ld in head | generatedLd(page.url) %}<script type="application/ld+json">
{{ ld | safe }}
</script>{% endfor %}
</head>
<body><main class="wrap">{%- if page.url == "/research/" or page.url.startsWith("/research/") -%}<aside style="border-left:3px solid #7AAFFF;background:rgba(122,175,255,.10);padding:16px 20px;margin:0 0 28px;color:#E6EAF2"><strong style="color:#fff">Auditing your own LLM spend?</strong> FinOps LLM runs a free audit of your AI costs and shows where the savings are. <a href="/book">Book free audit &rarr;</a></aside>{%- endif -%}{%- block body -%}{%- endblock -%}
{#- FAQPage schema used to be the only place these lived. Google requires the
    Q&A be visible on the page, and a question nobody can see is also a question
    nobody can cite. Rendering from head.faq means schema and page cannot drift. -#}
{%- if head.faq and head.faq.length -%}<section class="faq" aria-labelledby="faq-heading" style="margin-top:48px;border-top:1px solid #1E2A3F;padding-top:28px"><h2 id="faq-heading">FAQ</h2>{%- for f in head.faq -%}<h3 style="margin:24px 0 6px;font-size:17px">{{ f.q }}</h3><p>{{ f.a }}</p>{%- endfor -%}</section>{%- endif -%}
<footer style="margin-top:56px;padding-top:20px;border-top:1px solid #1E2A3F;font-size:13px;color:#647289;display:flex;gap:12px;flex-wrap:wrap;justify-content:space-between"><span>© 2026 FinOps LLM</span><span><a href="/privacy">Privacy</a> · <a href="/terms">Terms</a> · <a href="/security">Security</a></span></footer></main></body></html>
