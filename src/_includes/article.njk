{%- set article = articles[slug] -%}
{%- if not article -%}
  {{ throw("Missing article data for slug: " + slug) }}
{%- endif -%}
{%- set lang = lang or 'en' -%}
{%- set locale = article.languages[lang] or article.languages['en'] -%}
{%- set ui = articleUi[lang] or articleUi['en'] -%}
{%- if not locale -%}
  {{ throw("Missing language " + lang + " and no English fallback for article: " + slug) }}
{%- endif -%}
{%- set siteUrl = 'https://finopsllm.com' -%}
{#- `slug` is the _data/articles key (a bare filename); article.slug is the URL
    path ("research/..."). Using the key for URLs drops the /research prefix and
    every canonical/hreflang/langswitcher on that article 404s. -#}
{%- set urlSlug = article.slug or slug -%}
{#- A "-v2" article is an A/B variant of the article at the same slug without the
    suffix. Both were self-canonical and both sat in the sitemap, so the variant
    competed with its own control on an identical title and description. It
    canonicals to the control instead — in every locale, since the controls all
    exist here. -#}
{%- set controlSlug = urlSlug -%}
{%- if urlSlug.slice(-3) == '-v2' -%}{%- set controlSlug = urlSlug.slice(0, -3) -%}{%- endif -%}
{%- set canonicalPath = ('/' + lang + '/' + controlSlug) if lang != 'en' else ('/' + controlSlug) -%}
{%- set canonicalUrl = siteUrl + canonicalPath -%}

{#- An article whose English version is a hand-written .njk (not a `languages.en`
    entry) would otherwise drop English from both the hreflang set and the
    language switcher, because both iterate the JSON's own keys. The English page
    still exists at the un-prefixed path, so prepend 'en' when it is missing. -#}
{%- set codes = [] -%}
{%- if not article.languages['en'] -%}{%- set _ = codes.push('en') -%}{%- endif -%}
{%- for code in article.languages | keys -%}{%- set _ = codes.push(code) -%}{%- endfor -%}

{#- hreflang must name canonical URLs. Built from urlSlug, a -v2 variant told
    Google "the en/es version of me is /…-v2" while its own canonical pointed at
    the control — an inconsistent cluster Google drops wholesale. controlSlug is
    identical to urlSlug on every non-variant article. -#}
{%- set hreflangs = [] -%}
{%- for code in codes -%}
  {%- set prefix = '/' + code if code != 'en' else '' -%}
  {%- set _ = hreflangs.push({ lang: code, href: siteUrl + prefix + '/' + controlSlug }) -%}
{%- endfor -%}
{%- set _ = hreflangs.push({ lang: 'x-default', href: siteUrl + '/' + controlSlug }) -%}

{%- set jsonLdArticle = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": locale.title,
  "description": locale.description,
  "url": canonicalUrl,
  "datePublished": article.datePublished,
  "dateModified": article.dateModified,
  "image": article.image,
  "author": { "@type": "Organization", "name": "FinOps LLM team" },
  "publisher": { "@type": "Organization", "name": "FinOps LLM", "url": siteUrl + '/' }
} -%}

{%- set breadcrumbLabels = {
  en: ["Home", "Research"],
  de: ["Startseite", "Forschung"],
  es: ["Inicio", "Investigación"],
  fr: ["Accueil", "Recherche"],
  ja: ["ホーム", "リサーチ"],
  pt: ["Início", "Pesquisa"],
  it: ["Home", "Ricerca"],
  ko: ["홈", "리서치"],
  zh: ["首页", "研究"],
  nl: ["Home", "Onderzoek"],
  ar: ["الرئيسية", "أبحاث"]
} -%}
{%- set bl = breadcrumbLabels[lang] or breadcrumbLabels['en'] -%}
{%- set breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": bl[0], "item": siteUrl + '/' },
    { "@type": "ListItem", "position": 2, "name": bl[1], "item": siteUrl + '/research' },
    { "@type": "ListItem", "position": 3, "name": locale.titleCore or locale.title, "item": canonicalUrl }
  ]
} -%}


<!DOCTYPE html>
<html lang="{{ lang }}"{% if lang == 'ar' %} dir="rtl"{% endif %}>
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#F6F9FC" />
<title>{{ locale.title }} · FinOps LLM</title>
<meta name="description" content="{{ locale.description }}" />
<meta name="robots" content="index, follow" />
<meta name="theme-color" content="#0A0F1A" />
{%- if article.agentMode -%}
<meta name="content-signal" content="search=yes, ai-input=yes, ai-train=yes" />
{%- endif -%}
<link rel="canonical" href="{{ canonicalUrl }}" />
<meta property="og:type" content="article" />
<meta property="og:site_name" content="FinOps LLM" />
<meta property="og:locale" content="{{ lang }}" />
<meta property="og:url" content="{{ canonicalUrl }}" />
<meta property="og:title" content="{{ locale.titleCore or locale.title }}" />
<meta property="og:description" content="{{ locale.description }}" />
<meta property="og:image" content="{{ article.image or (siteUrl + '/og.png') }}" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="FinOps LLM" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="{{ locale.titleCore or locale.title }}" />
<meta name="twitter:description" content="{{ locale.description }}" />
<meta name="twitter:image" content="{{ article.image or (siteUrl + '/og.png') }}" />
{%- for alt in hreflangs -%}
<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.href }}" />
{%- endfor -%}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<style>
body{font-family:Inter,system-ui,sans-serif;margin:0;background:#0A0F1A;color:#E6EAF2;line-height:1.68}
.wrap{max-width:840px;margin:0 auto;padding:56px 24px}
a{color:#7AAFFF}
p,li{color:#B6C0D2}
h1{line-height:1.08}
h2{margin-top:34px}
h3{margin-top:26px;color:#E6EAF2}
code{background:#101726;padding:2px 6px;border-radius:4px;color:#E6EAF2;font-size:.92em;direction:ltr;unicode-bidi:embed}
pre{background:#101726;border:1px solid #1E2A3F;border-radius:6px;padding:14px 16px;overflow-x:auto;color:#E6EAF2;font-size:.9em;direction:ltr;text-align:left;unicode-bidi:embed}
pre code{background:none;padding:0}
table{border-collapse:collapse;width:100%;margin:24px 0;font-size:.95em}
th,td{border:1px solid #1E2A3F;padding:10px 12px;text-align:{% if lang == 'ar' %}right{% else %}left{% endif %};color:#B6C0D2}
th{color:#E6EAF2;background:#101726}
.langsw{font-family:'JetBrains Mono',ui-monospace,monospace;font-size:13px;color:#647289;margin:0 0 26px;direction:ltr}
.langsw a{text-decoration:none}
.langsw a[aria-current]{color:#E6EAF2;font-weight:600}
.agent-summary{border-{% if lang == 'ar' %}right{% else %}left{% endif %}:3px solid #7AAFFF;background:rgba(122,175,255,.10);padding:16px 20px;margin:0 0 28px;color:#E6EAF2}
</style>
<script type="application/ld+json">{{ jsonLdArticle | dump | safe }}</script>
<script type="application/ld+json">{{ breadcrumb | dump | safe }}</script>
{%- if locale.faq.length > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for q in locale.faq -%}
    {
      "@type": "Question",
      "name": {{ q.question | dump | safe }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ q.answer | dump | safe }}
      }
    }{%- if not loop.last -%},{%- endif -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}
{%- if article.agentMode -%}
<script type="text/x-llms-txt">
# {{ locale.title }}
> {{ locale.description }}
- URL: {{ canonicalUrl }}
- Content-Signal: search=yes, ai-input=yes, ai-train=yes
{%- for q in locale.faq %}
Q: {{ q.question }}
A: {{ q.answer }}
{%- endfor %}
</script>
{%- endif -%}
<script src="/assets/consent.js" defer></script>
<script src="/assets/attribution.js" defer></script>
<script src="/assets/lang.js" defer></script>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&display=swap" />
<link rel="stylesheet" href="/assets/editorial.css" />
</head>
<body>
{% include "site-header.njk" %}
<main class="wrap" id="main-content">
{% if '/research' in page.url %}<nav class="site-breadcrumb" aria-label="Breadcrumb"><a href="/">{{ (articleUi[lang or 'en'] or articleUi.en).home }}</a><span aria-hidden="true">/</span><a href="{% if lang in ['de', 'es', 'fr', 'ja', 'pt'] %}/{{ lang }}{% endif %}/research">{{ (articleUi[lang or 'en'] or articleUi.en).research }}</a>{% if '/research/' in page.url %}<span aria-hidden="true">/</span><span>{{ (articleUi[lang or 'en'] or articleUi.en).article }}</span>{% endif %}</nav>{% endif %}


<nav class="langsw" aria-label="{{ ui.language }}">
{%- for code in codes -%}
  {%- set prefix = '/' + code if code != 'en' else '' -%}
  {%- set label = code | upper -%}
  {%- if code == lang -%}<a href="{{ prefix }}/{{ urlSlug }}" hreflang="{{ code }}" aria-current="page">{{ label }}</a>
  {%- else -%}<a href="{{ prefix }}/{{ urlSlug }}" hreflang="{{ code }}">{{ label }}</a>
  {%- endif -%}
  {%- if not loop.last -%} · {%- endif -%}
{%- endfor -%}
</nav>



<h1>{{ locale.titleCore or locale.title }}</h1>
<p class="updated" style="color:#6B7689;font-size:14px;margin-top:-6px">{{ ui.updated }} {{ article.dateModified | formatDate }} · {{ ui.published }} {{ article.datePublished | formatDate }}</p>

{%- if article.agentMode -%}
<section class="agent-summary" aria-label="Agent summary">
  <strong>{{ ui.quick }}:</strong> {{ locale.body | striptags | truncate(200) }}
</section>
{%- endif -%}

{{ locale.body | safe }}

{%- if locale.related.length > 0 -%}
<h2>{{ ui.related }}</h2>
<ul>
{%- for link in locale.related -%}
  {%- set relatedHref = link.slug -%}
  {%- for relatedKey in articles | keys -%}
    {%- set relatedArticle = articles[relatedKey] -%}
    {%- if '/' + relatedArticle.slug == link.slug -%}
      {%- if lang != 'en' and relatedArticle.languages[lang] -%}
        {%- set relatedHref = '/' + lang + link.slug -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
  <li><a href="{{ relatedHref }}">{{ link.label }}</a></li>
{%- endfor -%}
</ul>
{%- endif -%}

<hr style="margin:48px 0 24px;border:none;border-top:1px solid #1E2A3F" />
<p><strong>{{ ui.bottomLead }}</strong> {{ ui.bottomBody }} <a href="/book">{{ ui.auditButton }} &rarr;</a></p>
<p><a href="{% if lang in ['de', 'es', 'fr', 'ja', 'pt'] %}/{{ lang }}{% endif %}/research">{{ ui.back }}</a></p>
<footer style="margin-top:56px;padding-top:20px;border-top:1px solid #1E2A3F;font-size:13px;color:#647289;display:flex;gap:12px;flex-wrap:wrap;justify-content:space-between"><span>© 2026 FinOps LLM</span><span><a href="/privacy">{{ ui.privacy }}</a> · <a href="/terms">{{ ui.terms }}</a> · <a href="/security">{{ ui.security }}</a></span></footer>
</main>
</body>
</html>
