---
pagination:
  data: homeUi
  size: 1
  alias: lang
permalink: "{{ 'index.html' if lang == 'en' else lang + '/index.html' }}"
---
{% set t = homeUi[lang] %}{% set base = 'https://finopsllm.com/' if lang == 'en' else 'https://finopsllm.com/' + lang + '/' %}{% set rp = '/research' if lang == 'en' else '/' + lang + '/research' %}<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8" />
<meta name="msvalidate.01" content="53BB61CAA2A3130541DEE41206C8C057" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{{ t.meta.title | safe }}</title>
<meta name="description" content="{{ t.meta.description | safe }}" />
<meta name="keywords" content="{{ t.meta.keywords | safe }}" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
<meta name="theme-color" content="#FAFBFD" />
<link rel="canonical" href="{{ base }}" />
{% for l, d in homeUi %}<link rel="alternate" hreflang="{{ l }}" href="{{ 'https://finopsllm.com/' if l == 'en' else 'https://finopsllm.com/' + l + '/' }}" />
{% endfor %}
<link rel="alternate" hreflang="x-default" href="https://finopsllm.com/" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />

<meta property="og:type" content="website" />
<meta property="og:url" content="{{ base }}" />
<meta property="og:title" content="{{ t.meta.ogTitle | safe }}" />
<meta property="og:description" content="{{ t.meta.ogDesc | safe }}" />
<meta property="og:image" content="https://finopsllm.com/og.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="FinOps LLM" />
<meta property="og:locale" content="{{ t.ogLocale }}" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@finopsllm" />
<meta name="twitter:title" content="{{ t.meta.twTitle | safe }}" />
<meta name="twitter:description" content="{{ t.meta.twDesc | safe }}" />
<meta name="twitter:image" content="https://finopsllm.com/og.png" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap" rel="stylesheet" />


