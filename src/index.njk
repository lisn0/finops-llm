<style>
:root{
  --bg:#F6F9FC;
  --panel:#FFFFFF;
  --ink:#0A1E3C;
  --ink-2:#33465E;
  --muted:#6B7C93;
  --blue:#1D4ED8;
  --blue-soft:#E4ECFB;
  --orange:#EA580C;
  --green:#0E9F6E;
  --line:#C9D6E6;
  --line-2:#DCE6F2;
  --gridline:rgba(29,78,216,.07);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg);
  background-image:
    linear-gradient(var(--gridline) 1px, transparent 1px),
    linear-gradient(90deg, var(--gridline) 1px, transparent 1px);
  background-size:36px 36px;
  color:var(--ink);
  font-family:'Inter',system-ui,sans-serif;
  font-size:15.5px;line-height:1.65;
  -webkit-font-smoothing:antialiased;
}
::selection{background:var(--blue);color:#fff}
.grotesk{font-family:'Space Grotesk',sans-serif}
.mono{font-family:'IBM Plex Mono',monospace}
.wrap{max-width:1240px;margin:0 auto;padding:0 40px}
@media(max-width:720px){.wrap{padding:0 22px}}

/* crosshair card corners */
.xcard{position:relative;background:var(--panel);border:1px solid var(--line)}
.xcard::before,.xcard::after,
.xcard .x::before,.xcard .x::after{
  content:"";position:absolute;width:11px;height:11px;pointer-events:none;
  background:
    linear-gradient(var(--blue),var(--blue)) center/11px 1.5px no-repeat,
    linear-gradient(var(--blue),var(--blue)) center/1.5px 11px no-repeat;
}
.xcard::before{top:-6px;left:-6px}
.xcard::after{top:-6px;right:-6px}
.xcard .x::before{bottom:-6px;left:-6px}
.xcard .x::after{bottom:-6px;right:-6px}

/* ---------- topbar ---------- */
.topbar{border-bottom:1px solid var(--line);background:rgba(246,249,252,.9);backdrop-filter:blur(8px);position:sticky;top:0;z-index:50}
.topbar-in{display:flex;align-items:center;justify-content:space-between;padding:16px 0;gap:24px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink)}
.brand .glyph{width:32px;height:32px;border:1.5px solid var(--blue);position:relative;display:grid;place-items:center}
.brand .glyph::before{content:"";position:absolute;inset:5px;border:1.5px solid var(--blue);opacity:.45}
.brand .glyph span{font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:11px;color:var(--blue)}
.brand .name{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:19px;letter-spacing:-.01em}
.brand .rev{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--muted);letter-spacing:.16em;text-transform:uppercase}
nav.main{display:flex;gap:26px;align-items:center}
nav.main a{color:var(--ink-2);text-decoration:none;font-size:13.5px;font-weight:500}
nav.main a:hover{color:var(--blue)}
nav.main a.btn-blue{color:#fff}
nav.main a.btn-blue:hover{color:#fff}
.btn{display:inline-flex;align-items:center;gap:9px;text-decoration:none;font-weight:600;font-size:14px;padding:12px 24px;border:1.5px solid var(--ink);transition:all .18s ease;cursor:pointer;font-family:'Space Grotesk',sans-serif;letter-spacing:.01em}
.btn-blue{background:var(--blue);border-color:var(--blue);color:#fff;box-shadow:4px 4px 0 var(--blue-soft)}
.btn-blue:hover{background:var(--ink);border-color:var(--ink);box-shadow:4px 4px 0 var(--line)}
.btn-ghost{background:var(--panel);color:var(--ink);border-color:var(--line)}
.btn-ghost:hover{border-color:var(--ink)}
.btn-sm{padding:8px 18px;font-size:13px}
@media(max-width:900px){nav.main a:not(.btn){display:none}}

/* ---------- hero ---------- */
.hero{padding:90px 0 80px;border-bottom:1px solid var(--line)}
.hero-grid{display:grid;grid-template-columns:1.15fr .95fr;gap:70px;align-items:center}
.tag-row{display:flex;gap:12px;align-items:center;margin-bottom:30px;flex-wrap:wrap}
.tag{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--blue);border:1px solid var(--blue);padding:6px 13px;background:var(--panel)}
.tag.dim{color:var(--muted);border-color:var(--line)}
h1.display{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(46px,6.4vw,86px);line-height:1.0;letter-spacing:-.035em;margin-bottom:28px}
h1.display .hl{color:var(--blue);position:relative}
h1.display .hl::after{content:"";position:absolute;left:0;right:0;bottom:.06em;height:.14em;background:var(--blue-soft);z-index:-1}
.lede{font-size:17.5px;line-height:1.7;color:var(--ink-2);max-width:540px;margin-bottom:36px}
.lede strong{color:var(--ink);font-weight:600}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:32px}
.hero-facts{display:flex;gap:8px 26px;flex-wrap:wrap;font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--muted)}
.hero-facts b{color:var(--green);font-weight:600}

/* spec sheet panel */
.spec{background:var(--panel);border:1px solid var(--ink);box-shadow:8px 8px 0 var(--blue-soft)}
.spec-head{display:flex;justify-content:space-between;align-items:center;padding:14px 22px;border-bottom:1px solid var(--ink);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase}
.spec-head .live{color:var(--green)}
.spec-head .live::before{content:"●";margin-right:8px;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.25}}
.spec-metrics{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--line-2)}
.metric{padding:20px 22px;border-right:1px solid var(--line-2)}
.metric:nth-child(2n){border-right:none}
.metric:nth-child(1),.metric:nth-child(2){border-bottom:1px solid var(--line-2)}
.metric .k{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.metric .v{font-family:'Space Grotesk',sans-serif;font-size:27px;font-weight:700;letter-spacing:-.02em}
.metric .d{font-family:'IBM Plex Mono',monospace;font-size:11px;margin-top:4px}
.metric .d.up{color:var(--green)}
.metric .d.warn{color:var(--orange)}
.spec-chart{padding:20px 22px 8px}
.spec-chart .lbl{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;display:flex;justify-content:space-between}
.spec-foot{padding:12px 22px 16px;font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--muted);letter-spacing:.06em;border-top:1px dashed var(--line)}

/* ---------- schematic ---------- */
.schematic{padding:70px 0;border-bottom:1px solid var(--line)}
.fig-cap{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--blue);margin-bottom:26px;display:flex;align-items:center;gap:14px}
.fig-cap::after{content:"";flex:1;height:1px;background:var(--line)}
.diagram{background:var(--panel);border:1px solid var(--ink);padding:40px;overflow-x:auto}
.diagram svg{display:block;min-width:760px;width:100%;height:auto}
@media(max-width:720px){.diagram{padding:20px}}

/* ---------- providers ---------- */
.providers{padding:34px 0;border-bottom:1px solid var(--line)}
.prov-in{display:flex;align-items:center;gap:26px;flex-wrap:wrap}
.prov-lbl{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.chip{font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:var(--ink-2);border:1px solid var(--line);background:var(--panel);padding:7px 15px}
.chip:hover{border-color:var(--blue);color:var(--blue)}

/* ---------- sections ---------- */
section{padding:88px 0;border-bottom:1px solid var(--line)}
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:54px;flex-wrap:wrap}
.sec-no{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);display:block;margin-bottom:14px}
h2.sec-title{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(34px,4.2vw,54px);line-height:1.05;letter-spacing:-.03em;max-width:660px}
h2.sec-title .hl{color:var(--blue)}
.sec-note{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--muted);max-width:310px;line-height:1.7}

/* pillars */
.pillars{display:grid;grid-template-columns:1fr 1fr;gap:28px}
.pillar{padding:36px 34px}
.pillar .fig{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);margin-bottom:20px;display:flex;justify-content:space-between}
.pillar h3{font-family:'Space Grotesk',sans-serif;font-size:26px;font-weight:700;letter-spacing:-.02em;margin-bottom:12px}
.pillar p{font-size:14.5px;color:var(--ink-2);margin-bottom:20px;line-height:1.7}
.pillar ul{list-style:none}
.pillar li{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--muted);padding:7px 0 7px 20px;position:relative;border-top:1px dashed var(--line-2)}
.pillar li::before{content:"▸";position:absolute;left:0;color:var(--blue)}
@media(max-width:820px){.pillars{grid-template-columns:1fr}}

/* research cards */
.research-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.research-card{display:block;text-decoration:none;background:var(--panel);border:1px solid var(--line);padding:28px;transition:border-color .15s,box-shadow .15s}
.research-card:hover{border-color:var(--blue);box-shadow:6px 6px 0 var(--blue-soft)}
.research-card .fig{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--blue);margin-bottom:16px;display:flex;justify-content:space-between}
.research-card h3{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;letter-spacing:-.02em;margin-bottom:10px;color:var(--ink)}
.research-card p{font-size:13.5px;color:var(--ink-2);line-height:1.6;margin-bottom:16px}
.research-card .meta{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--muted)}
@media(max-width:980px){.research-grid{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.research-grid{grid-template-columns:1fr}}

/* BOM levers */
.bom{border:1px solid var(--ink);background:var(--panel)}
.bom-head{display:grid;grid-template-columns:90px 1fr 1.2fr 150px;gap:24px;padding:16px 26px;background:var(--ink);color:#fff;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase}
.bom-row{display:grid;grid-template-columns:90px 1fr 1.2fr 150px;gap:24px;padding:24px 26px;border-bottom:1px solid var(--line-2);align-items:baseline;transition:background .15s}
.bom-row:hover{background:var(--blue-soft)}
.bom-row:last-child{border-bottom:none}
.bom-row .pn{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--muted)}
.bom-row h3{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;letter-spacing:-.01em}
.bom-row .desc{font-size:13.5px;color:var(--ink-2);line-height:1.6}
.bom-row .rng{font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:600;color:var(--blue);text-align:right}
@media(max-width:860px){.bom-head{display:none}.bom-row{grid-template-columns:1fr;gap:10px}.bom-row .rng{text-align:left}}

/* timeline */
.timeline{position:relative;padding-top:60px}
.tl-rail{position:absolute;top:30px;left:0;right:0;height:1.5px;background:var(--ink)}
.tl-rail .tick{position:absolute;top:-5px;width:1.5px;height:12px;background:var(--ink)}
.tl-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
.tl-step .marker{width:14px;height:14px;border:2.5px solid var(--blue);background:var(--bg);border-radius:50%;margin-bottom:24px;position:relative;top:-38px;margin-top:-7px}
.tl-step .wk{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);margin-bottom:10px}
.tl-step h3{font-family:'Space Grotesk',sans-serif;font-size:22px;font-weight:700;letter-spacing:-.01em;margin-bottom:10px}
.tl-step p{font-size:13.5px;color:var(--ink-2);line-height:1.65}
@media(max-width:860px){.tl-grid{grid-template-columns:1fr 1fr}.tl-rail{display:none}}
@media(max-width:520px){.tl-grid{grid-template-columns:1fr}}

/* pricing */
.plans{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:stretch}
.plan{padding:40px 38px;display:flex;flex-direction:column}
.plan.hot{border-color:var(--blue);box-shadow:8px 8px 0 var(--blue-soft)}
.plan .p-tag{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);margin-bottom:16px}
.plan h3{font-family:'Space Grotesk',sans-serif;font-size:30px;font-weight:700;letter-spacing:-.02em;margin-bottom:8px}
.plan .p-sub{font-size:14px;color:var(--muted);margin-bottom:26px;line-height:1.6}
.plan .p-price{font-family:'Space Grotesk',sans-serif;font-size:46px;font-weight:700;letter-spacing:-.03em;margin-bottom:4px}
.plan .p-price small{font-size:16px;font-weight:500;color:var(--muted);letter-spacing:0}
.plan .p-per{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:28px}
.plan ul{list-style:none;margin-bottom:34px;flex:1}
.plan li{font-size:14px;color:var(--ink-2);padding:9px 0 9px 26px;position:relative;border-top:1px dashed var(--line-2)}
.plan li::before{content:"✓";position:absolute;left:0;color:var(--green);font-weight:700}
@media(max-width:860px){.plans{grid-template-columns:1fr}}

/* faq */
.faq-list{border-top:1px solid var(--ink);max-width:840px}
details.faq{border-bottom:1px solid var(--line)}
details.faq summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:baseline;gap:24px;padding:24px 6px;font-family:'Space Grotesk',sans-serif;font-size:19px;font-weight:600;letter-spacing:-.01em}
details.faq summary::-webkit-details-marker{display:none}
details.faq summary .pm{font-family:'IBM Plex Mono',monospace;color:var(--blue);font-size:16px;flex-shrink:0}
details.faq .a{padding:0 6px 26px;font-size:14.5px;color:var(--ink-2);line-height:1.75;max-width:680px}
details.faq .a strong{color:var(--ink)}

/* cta */
.cta-panel{border:1.5px solid var(--ink);background:var(--panel);box-shadow:10px 10px 0 var(--blue-soft);padding:76px 60px;text-align:center;position:relative;overflow:hidden}
.cta-panel::before{content:"";position:absolute;inset:14px;border:1px dashed var(--line);pointer-events:none}
.cta-panel h2{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(36px,5vw,64px);letter-spacing:-.03em;line-height:1.02;margin-bottom:20px}
.cta-panel h2 .hl{color:var(--blue)}
.cta-panel p{color:var(--ink-2);font-size:16px;max-width:600px;margin:0 auto 38px;line-height:1.7}
.cta-panel .fine{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-top:30px}
@media(max-width:720px){.cta-panel{padding:56px 26px}}

/* footer */
footer{padding:60px 0 40px}
.foot-grid{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;margin-bottom:44px}
.foot-name{font-family:'Space Grotesk',sans-serif;font-size:26px;font-weight:700;letter-spacing:-.02em}
