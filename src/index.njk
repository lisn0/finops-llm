</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebSite","@id":"https://finopsllm.com/#website","name":"FinOps LLM","url":"https://finopsllm.com/","publisher":{"@id":"https://finopsllm.com/#org"}}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":["Service","ProfessionalService"],"name":"FinOps LLM","provider":{"@id":"https://finopsllm.com/#org"},"areaServed":"Worldwide","serviceType":"FinOps for AI, LLM cost audit, AI cost optimization","priceRange":"Performance-based; % of verified savings","description":{{ t.meta.serviceDesc | dump | safe }},"offers":{"@type":"Offer","priceCurrency":"USD","description":{{ t.meta.offerDesc | dump | safe }}}}
</script>
