{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{% for f in t.faq.items %}{"@type":"Question","name":{{ f.q | replace("&amp;","&") | dump | safe }},"acceptedAnswer":{"@type":"Answer","text":{{ f.a | striptags | replace("&amp;","&") | replace("&lt;","<") | dump | safe }}}}{% if not loop.last %},{% endif %}{% endfor %}]}
</script>
<style>
:root{
  --bg:#F6F9FC;
  --panel:#FFFFFF;
  --ink:#0A1E3C;
  --ink-2:#33465E;
  --muted:#6B7C93;
  --blue:#1D4ED8;
  --blue-soft:#E4ECFB;
  --orange:#EA580C;
  --green:#0E9F6E;
  --line:#C9D6E6;
  --line-2:#DCE6F2;
  --gridline:rgba(29,78,216,.07);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  background:var(--bg);
  background-image:
    linear-gradient(var(--gridline) 1px, transparent 1px),
    linear-gradient(90deg, var(--gridline) 1px, transparent 1px);
  background-size:36px 36px;
  color:var(--ink);
  font-family:'Inter',system-ui,sans-serif;
  font-size:15.5px;line-height:1.65;
  -webkit-font-smoothing:antialiased;
}
::selection{background:var(--blue);color:#fff}
.grotesk{font-family:'Space Grotesk',sans-serif}
.mono{font-family:'IBM Plex Mono',monospace}
.wrap{max-width:1240px;margin:0 auto;padding:0 40px}
@media(max-width:720px){.wrap{padding:0 22px}}

/* crosshair card corners */
.xcard{position:relative;background:var(--panel);border:1px solid var(--line)}
.xcard::before,.xcard::after,
.xcard .x::before,.xcard .x::after{
  content:"";position:absolute;width:11px;height:11px;pointer-events:none;
  background:
    linear-gradient(var(--blue),var(--blue)) center/11px 1.5px no-repeat,
    linear-gradient(var(--blue),var(--blue)) center/1.5px 11px no-repeat;
}
.xcard::before{top:-6px;left:-6px}
.xcard::after{top:-6px;right:-6px}
.xcard .x::before{bottom:-6px;left:-6px}
.xcard .x::after{bottom:-6px;right:-6px}

/* ---------- topbar ---------- */
.topbar{border-bottom:1px solid var(--line);background:rgba(246,249,252,.9);backdrop-filter:blur(8px);position:sticky;top:0;z-index:50}
.topbar-in{display:flex;align-items:center;justify-content:space-between;padding:16px 0;gap:24px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--ink)}
.brand .glyph{width:32px;height:32px;border:1.5px solid var(--blue);position:relative;display:grid;place-items:center}
.brand .glyph::before{content:"";position:absolute;inset:5px;border:1.5px solid var(--blue);opacity:.45}
.brand .glyph span{font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:11px;color:var(--blue)}
.brand .name{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:19px;letter-spacing:-.01em}
.brand .rev{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--muted);letter-spacing:.16em;text-transform:uppercase}
nav.main{display:flex;gap:26px;align-items:center}
nav.main a{color:var(--ink-2);text-decoration:none;font-size:13.5px;font-weight:500}
nav.main a:hover{color:var(--blue)}
nav.main a.btn-blue{color:#fff}
nav.main a.btn-blue:hover{color:#fff}
.btn{display:inline-flex;align-items:center;gap:9px;text-decoration:none;font-weight:600;font-size:14px;padding:12px 24px;border:1.5px solid var(--ink);transition:all .18s ease;cursor:pointer;font-family:'Space Grotesk',sans-serif;letter-spacing:.01em}
.btn-blue{background:var(--blue);border-color:var(--blue);color:#fff;box-shadow:4px 4px 0 var(--blue-soft)}
.btn-blue:hover{background:var(--ink);border-color:var(--ink);box-shadow:4px 4px 0 var(--line)}
.btn-ghost{background:var(--panel);color:var(--ink);border-color:var(--line)}
.btn-ghost:hover{border-color:var(--ink)}
.btn-sm{padding:8px 18px;font-size:13px}
@media(max-width:900px){nav.main a:not(.btn){display:none}}
@media(min-width:901px) and (max-width:1100px){nav.main{gap:14px;flex-wrap:wrap;justify-content:flex-end}}

/* ---------- hero ---------- */
.hero{padding:90px 0 80px;border-bottom:1px solid var(--line)}
.hero-grid{display:grid;grid-template-columns:1.15fr .95fr;gap:70px;align-items:center}
@media(max-width:820px){.hero-grid{grid-template-columns:1fr;gap:40px}}
.tag-row{display:flex;gap:12px;align-items:center;margin-bottom:30px;flex-wrap:wrap}
.tag{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--blue);border:1px solid var(--blue);padding:6px 13px;background:var(--panel)}
.tag.dim{color:var(--muted);border-color:var(--line)}
h1.display{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(46px,6.4vw,86px);line-height:1.0;letter-spacing:-.035em;margin-bottom:28px}
h1.display .hl{color:var(--blue);position:relative}
h1.display .hl::after{content:"";position:absolute;left:0;right:0;bottom:.06em;height:.14em;background:var(--blue-soft);z-index:-1}
.lede{font-size:17.5px;line-height:1.7;color:var(--ink-2);max-width:540px;margin-bottom:36px}
.lede strong{color:var(--ink);font-weight:600}
.hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:32px}
.hero-facts{display:flex;gap:8px 26px;flex-wrap:wrap;font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--muted)}
.hero-facts b{color:var(--green);font-weight:600}

/* ---------- Tidal Telemetry feature ---------- */
.telemetry{padding:62px 0;border-bottom:1px solid var(--line);background:rgba(255,255,255,.56)}
.telemetry-in{display:grid;grid-template-columns:.9fr 1.1fr;gap:54px;align-items:center}
.telemetry-copy .sec-no{margin-bottom:14px}
.telemetry-copy h2{font-family:'Space Grotesk',sans-serif;font-size:clamp(32px,4vw,48px);line-height:1.04;letter-spacing:-.03em;margin-bottom:16px}
.telemetry-copy h2 .hl{color:var(--blue)}
.telemetry-copy p{color:var(--ink-2);font-size:15px;line-height:1.75;margin-bottom:22px}
.telemetry-actions{display:flex;gap:12px;flex-wrap:wrap}
.telemetry-details{display:grid;grid-template-columns:1fr 1fr;border:1px solid var(--line);background:var(--panel)}
.telemetry-detail{padding:20px 22px;border-bottom:1px solid var(--line-2)}
.telemetry-detail:nth-child(odd){border-right:1px solid var(--line-2)}
.telemetry-detail:nth-last-child(-n+2){border-bottom:0}
.telemetry-detail h3{font-family:'Space Grotesk',sans-serif;font-size:17px;margin-bottom:5px}
.telemetry-detail p{font-size:12.5px;line-height:1.6;color:var(--ink-2)}
@media(max-width:820px){.telemetry-in{grid-template-columns:1fr;gap:28px}}
@media(max-width:520px){.telemetry-details{grid-template-columns:1fr}.telemetry-detail,.telemetry-detail:nth-child(odd){border-right:0;border-bottom:1px solid var(--line-2)}.telemetry-detail:last-child{border-bottom:0}}

/* spec sheet panel */
.spec{background:var(--panel);border:1px solid var(--ink);box-shadow:8px 8px 0 var(--blue-soft)}
.spec-head{display:flex;justify-content:space-between;align-items:center;padding:14px 22px;border-bottom:1px solid var(--ink);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase}
.spec-head .live{color:var(--green)}
.spec-head .live::before{content:"●";margin-right:8px;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.25}}
.spec-metrics{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid var(--line-2)}
.metric{padding:20px 22px;border-right:1px solid var(--line-2)}
.metric:nth-child(2n){border-right:none}
.metric:nth-child(1),.metric:nth-child(2){border-bottom:1px solid var(--line-2)}
.metric .k{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);margin-bottom:8px}
.metric .v{font-family:'Space Grotesk',sans-serif;font-size:27px;font-weight:700;letter-spacing:-.02em}
.metric .d{font-family:'IBM Plex Mono',monospace;font-size:11px;margin-top:4px}
.metric .d.up{color:var(--green)}
.metric .d.warn{color:var(--orange)}
.spec-chart{padding:20px 22px 8px}
.spec-chart .lbl{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-bottom:10px;display:flex;justify-content:space-between}
.spec-foot{padding:12px 22px 16px;font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--muted);letter-spacing:.06em;border-top:1px dashed var(--line)}

/* ---------- schematic ---------- */
.schematic{padding:70px 0;border-bottom:1px solid var(--line)}
.fig-cap{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--blue);margin-bottom:26px;display:flex;align-items:center;gap:14px}
.fig-cap::after{content:"";flex:1;height:1px;background:var(--line)}
.diagram{background:var(--panel);border:1px solid var(--ink);padding:40px;overflow-x:auto}
.diagram svg{display:block;min-width:760px;width:100%;height:auto}
@media(max-width:720px){.diagram{padding:20px}}

/* ---------- providers ---------- */
.providers{padding:34px 0;border-bottom:1px solid var(--line)}
.prov-in{display:flex;align-items:center;gap:26px;flex-wrap:wrap}
.prov-lbl{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.chip{font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:var(--ink-2);border:1px solid var(--line);background:var(--panel);padding:7px 15px}
.chip:hover{border-color:var(--blue);color:var(--blue)}

/* ---------- sections ---------- */
section{padding:88px 0;border-bottom:1px solid var(--line)}
.sec-head{display:flex;align-items:flex-end;justify-content:space-between;gap:30px;margin-bottom:54px;flex-wrap:wrap}
.sec-no{font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);display:block;margin-bottom:14px}
h2.sec-title{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(34px,4.2vw,54px);line-height:1.05;letter-spacing:-.03em;max-width:660px}
h2.sec-title .hl{color:var(--blue)}
.sec-note{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--muted);max-width:310px;line-height:1.7}

/* pillars */
.pillars{display:grid;grid-template-columns:1fr 1fr;gap:28px}
.pillar{padding:36px 34px}
.pillar .fig{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);margin-bottom:20px;display:flex;justify-content:space-between}
.pillar h3{font-family:'Space Grotesk',sans-serif;font-size:26px;font-weight:700;letter-spacing:-.02em;margin-bottom:12px}
.pillar p{font-size:14.5px;color:var(--ink-2);margin-bottom:20px;line-height:1.7}
.pillar ul{list-style:none}
.pillar li{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--muted);padding:7px 0 7px 20px;position:relative;border-top:1px dashed var(--line-2)}
.pillar li::before{content:"▸";position:absolute;left:0;color:var(--blue)}
@media(max-width:820px){.pillars{grid-template-columns:1fr}}

/* research cards */
.research-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px}
.research-card{display:block;text-decoration:none;background:var(--panel);border:1px solid var(--line);padding:28px;transition:border-color .15s,box-shadow .15s}
.research-card:hover{border-color:var(--blue);box-shadow:6px 6px 0 var(--blue-soft)}
.research-card .fig{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--blue);margin-bottom:16px;display:flex;justify-content:space-between}
.research-card h3{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;letter-spacing:-.02em;margin-bottom:10px;color:var(--ink)}
.research-card p{font-size:13.5px;color:var(--ink-2);line-height:1.6;margin-bottom:16px}
.research-card .meta{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--muted)}
@media(max-width:980px){.research-grid{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.research-grid{grid-template-columns:1fr}}

/* BOM levers */
.bom{border:1px solid var(--ink);background:var(--panel)}
.bom-head{display:grid;grid-template-columns:90px 1fr 1.2fr 150px;gap:24px;padding:16px 26px;background:var(--ink);color:#fff;font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase}
.bom-row{display:grid;grid-template-columns:90px 1fr 1.2fr 150px;gap:24px;padding:24px 26px;border-bottom:1px solid var(--line-2);align-items:baseline;transition:background .15s}
.bom-row:hover{background:var(--blue-soft)}
.bom-row:last-child{border-bottom:none}
.bom-row .pn{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--muted)}
.bom-row h3{font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:700;letter-spacing:-.01em}
.bom-row .desc{font-size:13.5px;color:var(--ink-2);line-height:1.6}
.bom-row .rng{font-family:'IBM Plex Mono',monospace;font-size:15px;font-weight:600;color:var(--blue);text-align:right}
@media(max-width:860px){.bom-head{display:none}.bom-row{grid-template-columns:1fr;gap:10px}.bom-row .rng{text-align:left}}

/* timeline */
.timeline{position:relative;padding-top:60px}
.tl-rail{position:absolute;top:30px;left:0;right:0;height:1.5px;background:var(--ink)}
.tl-rail .tick{position:absolute;top:-5px;width:1.5px;height:12px;background:var(--ink)}
.tl-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
.tl-step .marker{width:14px;height:14px;border:2.5px solid var(--blue);background:var(--bg);border-radius:50%;margin-bottom:24px;position:relative;top:-38px;margin-top:-7px}
.tl-step .wk{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);margin-bottom:10px}
.tl-step h3{font-family:'Space Grotesk',sans-serif;font-size:22px;font-weight:700;letter-spacing:-.01em;margin-bottom:10px}
.tl-step p{font-size:13.5px;color:var(--ink-2);line-height:1.65}
@media(max-width:860px){.tl-grid{grid-template-columns:1fr 1fr}.tl-rail{display:none}}
@media(max-width:520px){.tl-grid{grid-template-columns:1fr}}

/* pricing */
.plans{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:stretch}
.plan{padding:40px 38px;display:flex;flex-direction:column}
.plan.hot{border-color:var(--blue);box-shadow:8px 8px 0 var(--blue-soft)}
.plan .p-tag{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);margin-bottom:16px}
.plan h3{font-family:'Space Grotesk',sans-serif;font-size:30px;font-weight:700;letter-spacing:-.02em;margin-bottom:8px}
.plan .p-sub{font-size:14px;color:var(--muted);margin-bottom:26px;line-height:1.6}
.plan .p-price{font-family:'Space Grotesk',sans-serif;font-size:46px;font-weight:700;letter-spacing:-.03em;margin-bottom:4px}
.plan .p-price small{font-size:16px;font-weight:500;color:var(--muted);letter-spacing:0}
.plan .p-per{font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:28px}
.plan ul{list-style:none;margin-bottom:34px;flex:1}
.plan li{font-size:14px;color:var(--ink-2);padding:9px 0 9px 26px;position:relative;border-top:1px dashed var(--line-2)}
.plan li::before{content:"✓";position:absolute;left:0;color:var(--green);font-weight:700}
@media(max-width:860px){.plans{grid-template-columns:1fr}}

/* faq */
.faq-list{border-top:1px solid var(--ink);max-width:840px}
details.faq{border-bottom:1px solid var(--line)}
details.faq summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;align-items:baseline;gap:24px;padding:24px 6px;font-family:'Space Grotesk',sans-serif;font-size:19px;font-weight:600;letter-spacing:-.01em}
details.faq summary::-webkit-details-marker{display:none}
details.faq summary .pm{font-family:'IBM Plex Mono',monospace;color:var(--blue);font-size:16px;flex-shrink:0}
details.faq .a{padding:0 6px 26px;font-size:14.5px;color:var(--ink-2);line-height:1.75;max-width:680px}
details.faq .a strong{color:var(--ink)}

/* cta */
.cta-panel{border:1.5px solid var(--ink);background:var(--panel);box-shadow:10px 10px 0 var(--blue-soft);padding:76px 60px;text-align:center;position:relative;overflow:hidden}
.cta-panel::before{content:"";position:absolute;inset:14px;border:1px dashed var(--line);pointer-events:none}
.cta-panel h2{font-family:'Space Grotesk',sans-serif;font-weight:700;font-size:clamp(36px,5vw,64px);letter-spacing:-.03em;line-height:1.02;margin-bottom:20px}
.cta-panel h2 .hl{color:var(--blue)}
.cta-panel p{color:var(--ink-2);font-size:16px;max-width:600px;margin:0 auto 38px;line-height:1.7}
.cta-panel .fine{font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin-top:30px}
@media(max-width:720px){.cta-panel{padding:56px 26px}}

/* footer */
footer{padding:60px 0 40px}
.foot-grid{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;margin-bottom:44px}
.foot-name{font-family:'Space Grotesk',sans-serif;font-size:26px;font-weight:700;letter-spacing:-.02em}
.foot-tag{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--muted);letter-spacing:.16em;text-transform:uppercase;margin-top:8px}
.foot-links{display:flex;gap:60px;flex-wrap:wrap}
.foot-links h3{font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);margin-bottom:14px}
.foot-links a{display:block;color:var(--ink-2);text-decoration:none;font-size:13.5px;padding:4px 0}
.foot-links a:hover{color:var(--blue)}
.foot-base{border-top:1px solid var(--line);padding-top:22px;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-family:'IBM Plex Mono',monospace;font-size:10.5px;color:var(--muted);letter-spacing:.06em}
</style>
<link rel="stylesheet" href="/assets/landing.css" />
</head>
<body>
<a class="skip-link" href="#main-content">{{ t.skip | safe }}</a>
<!-- topbar -->
<header class="topbar">
  <div class="wrap topbar-in">
    <a class="brand" href="/" aria-label="{{ t.brandAria | safe }}">
      <img class="brand-logo" src="/assets/brand/finops-llm-horizontal-light.svg" width="340" height="54" alt="FinOps LLM" />
    </a>
    <nav class="main" aria-label="{{ t.nav.aria | safe }}">
      <a href="#pillars">{{ t.nav.whatWeDo | safe }}</a>
      <a href="#process">{{ t.nav.process | safe }}</a>
      <a href="#pricing">{{ t.nav.pricing | safe }}</a>
      <a href="/telemetry">{{ t.nav.telemetry | safe }}</a>
      <a href="{{ rp }}">{{ t.nav.research | safe }}</a>
      <a class="btn btn-blue btn-sm" href="/book">{{ t.nav.book | safe }}</a>
    </nav>
    <details class="mobile-menu">
      <summary>{{ t.nav.menu | safe }} <span aria-hidden="true">+</span></summary>
      <nav aria-label="{{ t.nav.mobileAria | safe }}">
        <a href="/about">{{ t.nav.whatWeDo | safe }}</a>
        <a href="/pricing">{{ t.nav.pricing | safe }}</a>
        <a href="/telemetry">{{ t.nav.telemetryFull | safe }}</a>
        <a href="{{ rp }}">{{ t.nav.research | safe }}</a>
        <a href="/tools/llm-cost-calculator">{{ t.nav.calculator | safe }}</a>
        <a class="mobile-audit" href="/book">{{ t.nav.book | safe }}</a>
      </nav>
    </details>
  </div>
</header>

<main id="main-content">
<!-- hero -->
<div class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="tag-row">
        <span class="tag">{{ t.hero.tag | safe }}</span>
      </div>
      <h1 class="display">{{ t.hero.h1 | safe }} <span class="hl">{{ t.hero.h1hl | safe }}</span></h1>
      <p class="lede">{{ t.hero.lede | safe }}</p>
      <div class="hero-ctas">
        <a class="btn btn-blue" href="/book">{{ t.nav.book | safe }}</a>
        <a class="btn btn-ghost" href="#pricing">{{ t.hero.cta2 | safe }}</a>
        <a class="btn btn-ghost" href="#telemetry">{{ t.tele.heroCta | safe }}</a>
      </div>
      <div class="hero-facts">
        {% for f in t.hero.facts %}<span><b>●</b> {{ f | safe }}</span>
        {% endfor %}
      </div>
    </div>

    <aside class="spec">
      <div class="spec-head"><span>{{ t.spec.head | safe }}</span><span class="demo-label">{{ t.spec.demo | safe }}</span></div>
      <div class="spec-metrics">
        {% set mv = ['$70,280', '$94,720', '38.1%', '+0.2%'] %}{% for m in t.spec.metrics %}<div class="metric"><div class="k">{{ m.k | safe }}</div><div class="v">{{ mv[loop.index0] }}</div><div class="d{{ ' up' if loop.index0 < 3 }}">{{ m.d | safe }}</div></div>
        {% endfor %}
      </div>
      <div class="spec-chart">
        <div class="lbl"><span>{{ t.spec.chartLbl | safe }}</span><span>{{ t.spec.chartToday | safe }}</span></div>
        <svg viewBox="0 0 520 120" width="100%" height="120" preserveAspectRatio="none" aria-hidden="true">
          <line x1="0" y1="30" x2="520" y2="30" stroke="#C9D6E6" stroke-dasharray="4 4"/>
          <text x="4" y="24" font-family="IBM Plex Mono" font-size="9" fill="#6B7C93">BASELINE $165K/mo</text>
          <path d="M0,34 L20,32 L40,35 L60,31 L80,34 L100,30 L120,33 L140,60 L160,78 L180,74 L200,82 L220,79 L240,86 L260,83 L280,88 L300,84 L320,90 L340,86 L360,91 L380,88 L400,92 L420,89 L440,93 L460,90 L480,94 L500,91 L520,94"
                fill="none" stroke="#1D4ED8" stroke-width="2.5"/>
          <path d="M0,34 L20,32 L40,35 L60,31 L80,34 L100,30 L120,33 L140,60 L160,78 L180,74 L200,82 L220,79 L240,86 L260,83 L280,88 L300,84 L320,90 L340,86 L360,91 L380,88 L400,92 L420,89 L440,93 L460,90 L480,94 L500,91 L520,94 L520,120 L0,120 Z"
                fill="#1D4ED8" opacity="0.07"/>
          <circle cx="140" cy="60" r="4" fill="#EA580C"/>
          <text x="150" y="56" font-family="IBM Plex Mono" font-size="9" fill="#EA580C">OPTIMIZATION LIVE</text>
        </svg>
      </div>
      <div class="spec-foot">{{ t.spec.foot | safe }}</div>
    </aside>
  </div>
</div>

<!-- Tidal Telemetry -->
<section class="telemetry" id="telemetry" aria-labelledby="telemetry-title">
  <div class="wrap telemetry-in">
    <div class="telemetry-copy">
      <span class="sec-no">{{ t.tele.tag | safe }}</span>
      <h2 id="telemetry-title">{{ t.tele.h2 | safe }} <span class="hl">{{ t.tele.h2hl | safe }}</span></h2>
      <p>{{ t.tele.p | safe }}</p>
      <div class="telemetry-actions">
        <a class="btn btn-blue" href="https://telemetry.llmcfo.com">{{ t.tele.visit | safe }}</a>
        <a class="btn btn-ghost" href="https://telemetry.llmcfo.com/docs">{{ t.tele.docs | safe }}</a>
      </div>
    </div>
    <div class="telemetry-details">
      {% for d in t.tele.details %}<div class="telemetry-detail"><h3>{{ d.h | safe }}</h3><p>{{ d.p | safe }}</p></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- schematic -->
<div class="schematic" id="schematic">
  <div class="wrap">
    <div class="fig-cap">FIG. 01 — {{ t.schematicCap | safe }}</div>
    <div class="diagram xcard"><span class="x"></span>
      <svg viewBox="0 0 1000 340" width="100%" aria-hidden="true">
        <defs>
          <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M0,0 L10,5 L0,10 z" fill="#1D4ED8"/>
          </marker>
        </defs>
        <!-- request box -->
        <rect x="20" y="140" width="170" height="70" fill="#FFFFFF" stroke="#0A1E3C" stroke-width="1.5"/>
        <text x="105" y="168" text-anchor="middle" font-family="Space Grotesk" font-weight="700" font-size="16" fill="#0A1E3C">REQUEST</text>
        <text x="105" y="190" text-anchor="middle" font-family="IBM Plex Mono" font-size="10" fill="#6B7C93">prompt + context</text>
        <!-- classifier -->
        <rect x="300" y="130" width="190" height="90" fill="#E4ECFB" stroke="#1D4ED8" stroke-width="1.5" stroke-dasharray="6 4"/>
        <text x="395" y="162" text-anchor="middle" font-family="Space Grotesk" font-weight="700" font-size="16" fill="#1D4ED8">CLASSIFIER</text>
        <text x="395" y="184" text-anchor="middle" font-family="IBM Plex Mono" font-size="10" fill="#1D4ED8">complexity score</text>
        <text x="395" y="200" text-anchor="middle" font-family="IBM Plex Mono" font-size="10" fill="#6B7C93">quality bar: ≥ SLO</text>
        <!-- paths -->
        <line x1="190" y1="175" x2="296" y2="175" stroke="#1D4ED8" stroke-width="1.5" marker-end="url(#arr)"/>
        <line x1="490" y1="150" x2="620" y2="60" stroke="#1D4ED8" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#arr)"/>
        <line x1="490" y1="175" x2="620" y2="175" stroke="#0E9F6E" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#arr)"/>
        <line x1="490" y1="200" x2="620" y2="290" stroke="#1D4ED8" stroke-width="1.5" stroke-dasharray="5 4" marker-end="url(#arr)"/>
        <!-- flagship -->
        <rect x="626" y="30" width="220" height="62" fill="#FFFFFF" stroke="#0A1E3C" stroke-width="1.5"/>
        <text x="736" y="56" text-anchor="middle" font-family="Space Grotesk" font-weight="700" font-size="15" fill="#0A1E3C">FLAGSHIP MODEL</text>
        <text x="736" y="76" text-anchor="middle" font-family="IBM Plex Mono" font-size="10" fill="#EA580C">$0.030 / 1K tok · reasoning only</text>
        <!-- cache -->
        <rect x="626" y="144" width="220" height="62" fill="#0E9F6E" stroke="#0E9F6E" stroke-width="1.5"/>
        <text x="736" y="170" text-anchor="middle" font-family="Space Grotesk" font-weight="700" font-size="15" fill="#FFFFFF">SEMANTIC CACHE</text>
        <text x="736" y="190" text-anchor="middle" font-family="IBM Plex Mono" font-size="10" fill="#D9F2E8">$0.0001 · sub-10ms · 38% hit-rate</text>
        <!-- small -->
        <rect x="626" y="258" width="220" height="62" fill="#FFFFFF" stroke="#0A1E3C" stroke-width="1.5"/>
        <text x="736" y="284" text-anchor="middle" font-family="Space Grotesk" font-weight="700" font-size="15" fill="#0A1E3C">SMALL FAST MODEL</text>
        <text x="736" y="304" text-anchor="middle" font-family="IBM Plex Mono" font-size="10" fill="#0E9F6E">$0.002 / 1K tok · extraction · classif.</text>
        <!-- savings annotation -->
        <text x="970" y="170" text-anchor="end" font-family="IBM Plex Mono" font-size="11" fill="#1D4ED8">−30 to −50%</text>
        <text x="970" y="186" text-anchor="end" font-family="IBM Plex Mono" font-size="9" fill="#6B7C93">routing lever</text>
        <!-- dimension line -->
        <line x1="20" y1="335" x2="846" y2="335" stroke="#C9D6E6"/>
        <line x1="20" y1="330" x2="20" y2="340" stroke="#C9D6E6"/>
        <line x1="846" y1="330" x2="846" y2="340" stroke="#C9D6E6"/>
        <text x="433" y="330" text-anchor="middle" font-family="IBM Plex Mono" font-size="9" fill="#6B7C93">EVERY REQUEST · A/B TESTED 7 DAYS · AUTO-ROLLBACK ON REGRESSION</text>
      </svg>
    </div>
  </div>
</div>

<!-- providers -->
<div class="providers">
  <div class="wrap prov-in">
    <span class="prov-lbl">{{ t.providersLbl | safe }}</span>
    <span class="chip">OpenAI</span><span class="chip">Anthropic</span><span class="chip">Gemini</span><span class="chip">Bedrock</span><span class="chip">Azure</span><span class="chip">Groq</span><span class="chip">Together</span><span class="chip">Mistral</span>
  </div>
</div>

<!-- pillars -->
<section id="pillars">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="sec-no">SEC. 01 — {{ t.pillars.no | safe }}</span>
        <h2 class="sec-title">{{ t.pillars.title | safe }} <span class="hl">{{ t.pillars.hl | safe }}</span></h2>
      </div>
      <p class="sec-note">{{ t.pillars.note | safe }}</p>
    </div>
    <div class="pillars">
      {% set figs = ['A', 'B', 'C', 'D'] %}{% for p in t.pillars.items %}<div class="pillar xcard"><span class="x"></span>
        <div class="fig"><span>FIG. 02-{{ figs[loop.index0] }}</span><span>{{ t.pillars.word | safe }} 0{{ loop.index }}</span></div>
        <h3>{{ p.h | safe }}</h3>
        <p>{{ p.p | safe }}</p>
        <ul>
          {% for li in p.li %}<li>{{ li | safe }}</li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
<!-- levers BOM -->
<section id="levers">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="sec-no">SEC. 02 — {{ t.levers.no | safe }}</span>
        <h2 class="sec-title">{{ t.levers.title | safe }} <span class="hl">{{ t.levers.hl | safe }}</span></h2>
      </div>
      <p class="sec-note">{{ t.levers.note | safe }}</p>
    </div>
    <div class="bom xcard"><span class="x"></span>
      <div class="bom-head"><span>{{ t.levers.head[0] | safe }}</span><span>{{ t.levers.head[1] | safe }}</span><span>{{ t.levers.head[2] | safe }}</span><span style="text-align:right">{{ t.levers.head[3] | safe }}</span></div>
      {% set rng = ['30–50%', '20–40%', '15–30%', '10–50%', '20–35%', '5–15%'] %}{% for it in t.levers.items %}<div class="bom-row"><span class="pn">OPT-0{{ loop.index }}</span><h3>{{ it.h | safe }}</h3><p class="desc">{{ it.desc | safe }}</p><span class="rng">{{ rng[loop.index0] }}</span></div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- process timeline -->
<section id="process">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="sec-no">SEC. 03 — {{ t.process.no | safe }}</span>
        <h2 class="sec-title">{{ t.process.title | safe }} <span class="hl">{{ t.process.hl | safe }}</span></h2>
      </div>
      <p class="sec-note">{{ t.process.note | safe }}</p>
    </div>
    <div class="timeline">
      <div class="tl-rail"></div>
      <div class="tl-grid">
        {% for s in t.process.items %}<div class="tl-step">
          <div class="wk">{{ s.wk | safe }}</div>
          <h3>{{ s.h | safe }}</h3>
          <p>{{ s.p | safe }}</p>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

<!-- pricing -->
<section id="pricing">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="sec-no">SEC. 04 — {{ t.pricing.no | safe }}</span>
        <h2 class="sec-title">{{ t.pricing.title | safe }} <span class="hl">{{ t.pricing.hl | safe }}</span></h2>
      </div>
      <p class="sec-note">{{ t.pricing.note | safe }}</p>
    </div>
    <div class="plans">
      <div class="plan xcard hot"><span class="x"></span>
        <div class="p-tag">{{ t.pricing.perf.tag | safe }}</div>
        <h3>{{ t.pricing.perf.h | safe }}</h3>
        <p class="p-sub">{{ t.pricing.perf.sub | safe }}</p>
        <div class="p-price">20<small>%</small></div>
        <div class="p-per">{{ t.pricing.perf.per | safe }}</div>
        <ul>
          {% for li in t.pricing.perf.items %}<li>{{ li | safe }}</li>
          {% endfor %}
        </ul>
        <a class="btn btn-blue" href="#start" style="justify-content:center">{{ t.pricing.perf.btn | safe }}</a>
      </div>
      <div class="plan xcard"><span class="x"></span>
        <div class="p-tag">{{ t.pricing.suite.tag | safe }}</div>
        <h3>{{ t.pricing.suite.h | safe }}</h3>
        <p class="p-sub">{{ t.pricing.suite.sub | safe }}</p>
        <div class="p-price">{{ t.pricing.suite.price | safe }}<small>{{ t.pricing.suite.priceSmall | safe }}</small></div>
        <div class="p-per">{{ t.pricing.suite.per | safe }}</div>
        <ul>
          {% for li in t.pricing.suite.items %}<li>{{ li | safe }}</li>
          {% endfor %}
        </ul>
        <a class="btn btn-ghost" href="/telemetry" style="justify-content:center">{{ t.pricing.suite.btn | safe }}</a>
      </div>
    </div>
  </div>
</section>

<!-- faq -->
<section id="faq">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="sec-no">SEC. 05 — {{ t.faq.no | safe }}</span>
        <h2 class="sec-title">{{ t.faq.title | safe }} <span class="hl">{{ t.faq.hl | safe }}</span></h2>
      </div>
      <p class="sec-note">{{ t.faq.note | safe }}</p>
    </div>
    <div class="faq-list">
      {% for f in t.faq.items %}<details class="faq"{{ ' open' if loop.first }}>
        <summary>{{ f.q | safe }} <span class="pm">[+]</span></summary>
        <div class="a">{{ f.a | safe }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<!-- research -->
<section id="research">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <span class="sec-no">SEC. 06 — {{ t.research.no | safe }}</span>
        <h2 class="sec-title">{{ t.research.title | safe }} <span class="hl">{{ t.research.hl | safe }}</span></h2>
      </div>
      <p class="sec-note">{{ t.research.note | safe }}</p>
    </div>
    <div class="research-grid">
      {% for c in t.research.cards %}<a class="research-card xcard" href="{{ ('/' + lang + '/research/' + c.slug) if (lang != 'en' and c.slug in ['finops-for-llm', 'how-much-does-gpt5-cost']) else ('/research/' + c.slug) }}">
        <div class="fig"><span>{{ t.research.guide | safe }}</span><span>{{ c.badge | safe }}</span></div>
        <h3>{{ c.title | safe }}</h3>
        <p>{{ c.desc | safe }}</p>
        <div class="meta">{{ c.meta | safe }}</div>
      </a>
      {% endfor %}
    </div>
    <p style="margin-top:28px"><a class="btn btn-ghost" href="{{ rp }}">{{ t.research.browse | safe }}</a></p>
  </div>
</section>

<!-- cta -->
<section id="start" style="border-bottom:none">
  <div class="wrap">
    <div class="cta-panel xcard"><span class="x"></span>
      <span class="sec-no">SEC. 07 — {{ t.cta.no | safe }}</span>
      <h2>{{ t.cta.title | safe }} <span class="hl">{{ t.cta.hl | safe }}</span></h2>
      <p>{{ t.cta.p | safe }}</p>
      <div class="hero-ctas cta-actions">
        <a class="btn btn-blue" href="/book">{{ t.cta.btn | safe }}</a>
        <a class="btn btn-ghost" href="mailto:hello@finopsllm.com">hello@finopsllm.com</a>
      </div>
      <div class="fine">{{ t.cta.fine | safe }}</div>
    </div>
  </div>
</section>

</main>
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="footer-brand" href="/" aria-label="{{ t.brandAria | safe }}"><img src="/assets/brand/finops-llm-horizontal-light.svg" width="340" height="54" alt="FinOps LLM" /></a>
        <div class="foot-tag">{{ t.footer.tag | safe }}</div>
      </div>
      <div class="foot-links">
        <div>
          <h3>{{ t.footer.platform | safe }}</h3>
          <a href="#pillars">{{ t.footer.pillars | safe }}</a>
          <a href="#levers">{{ t.footer.techniques | safe }}</a>
          <a href="/pricing">{{ t.footer.pricing | safe }}</a>
          <a href="/book">{{ t.footer.book | safe }}</a>
          <a href="/contact">{{ t.footer.contact | safe }}</a>
        </div>
        <div>
          <h3>{{ t.footer.resources | safe }}</h3>
          <a href="{{ rp }}">{{ t.footer.research | safe }}</a>
          <a href="/templates">{{ t.footer.templates | safe }}</a>
          <a href="/compare/llm-gateways">{{ t.footer.compare | safe }}</a>
          <a href="/telemetry">{{ t.footer.telemetry | safe }}</a>
          <a href="/audit/openai">{{ t.footer.auditOpenai | safe }}</a>
          <a href="/audit/bedrock">{{ t.footer.auditBedrock | safe }}</a>
          <a href="/audit/vertex-ai">{{ t.footer.auditVertex | safe }}</a>
          <a href="/tools/llm-cost-calculator">{{ t.footer.calculator | safe }}</a>
          <a href="/tools/llm-api-pricing-tracker">{{ t.footer.pricingTracker | safe }}</a>
          <a href="/tools/llm-release-tracker">{{ t.footer.releaseTracker | safe }}</a>
          <a href="/benchmarks">{{ t.footer.benchmarks | safe }}</a>
          <a href="/case-studies">{{ t.footer.caseStudies | safe }}</a>
          <a href="/glossary">{{ t.footer.glossary | safe }}</a>
          <a href="#faq">{{ t.footer.faq | safe }}</a>
        </div>
        <div>
          <h3>{{ t.footer.company | safe }}</h3>
          <a href="/about">{{ t.footer.about | safe }}</a>
          <a href="/careers">{{ t.footer.careers | safe }}</a>
          <a href="/security">{{ t.footer.security | safe }}</a>
          <a href="/privacy">{{ t.footer.privacy | safe }}</a>
          <a href="/terms">{{ t.footer.terms | safe }}</a>
        </div>
        <div>
          <h3>{{ t.footer.contactH | safe }}</h3>
          <a href="mailto:hello@finopsllm.com">hello@finopsllm.com</a>
          <a href="#start">{{ t.footer.bookAudit | safe }}</a>
        </div>
        <!-- The locale homepages were in the sitemap but hreflang was the only
             thing pointing at them, so nothing crawlable linked them. -->
        <div>
          <h3>{{ t.footer.languages | safe }}</h3>
          {% for l, d in homeUi %}{% if l != lang %}<a href="{{ '/' if l == 'en' else '/' + l + '/' }}" hreflang="{{ l }}">{{ d.langName }}</a>
          {% endif %}{% endfor %}
        </div>
      </div>
    </div>
    <div class="foot-base">
      <span>© 2026 FinOps LLM</span>
      <span>SCALE 1:1 · SHEET 01 OF 01 · REV C</span>
    </div>
  </div>
</footer>

<script src="/assets/consent.js" defer></script><script src="/assets/attribution.js" defer></script>
</body>
</html>
