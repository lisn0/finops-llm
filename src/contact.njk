{
  "permalink": "contact.html",
  "lang": "en",
  "head": {
    "title": "Contact FinOps LLM",
    "description": "Ask about an AI spend audit, Tidal Telemetry, partnerships, or support. People and agents can send the same contact request.",
    "canonical": "https://finopsllm.com/contact",
    "style": "body{font-family:Inter,system-ui,sans-serif;margin:0;background:#0A0F1A;color:#E6EAF2;line-height:1.65}.wrap{max-width:760px;margin:0 auto;padding:56px 24px}a{color:#7AAFFF}p{color:#B6C0D2}form{display:grid;gap:16px}label{display:grid;gap:5px}input,select,textarea{box-sizing:border-box;width:100%;padding:11px;background:#121B2C;color:#E6EAF2;border:1px solid #58657A;border-radius:5px;font:inherit}button{padding:12px 20px;background:#7AAFFF;border:0;border-radius:5px;color:#0A0F1A;font:inherit;font-weight:700;cursor:pointer}.trap{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}#contact-status{min-height:1.5em}",
    "scripts": [{ "src": "/assets/contact.js", "defer": true }]
  }
