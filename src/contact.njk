---
{% extends "shell.njk" %}{% block body %}
<h1>Contact FinOps LLM</h1>
<p>Ask us about an AI spend audit, Tidal Telemetry, or a partnership. Do not include passwords, API keys, or customer data in this form.</p>
<form id="contact-form" action="/api/contact" method="post">
  <label>Name <input name="name" autocomplete="name" maxlength="120" required></label>
  <label>Work email <input name="email" type="email" autocomplete="email" maxlength="254" required></label>
  <label>Company <input name="company" autocomplete="organization" maxlength="160" required></label>
  <label>Topic <select name="topic" required><option value="">Choose a topic</option><option value="audit">AI spend audit</option><option value="telemetry">Tidal Telemetry</option><option value="partnership">Partnership</option><option value="support">Support</option><option value="other">Other</option></select></label>
  <label>Message <textarea name="message" rows="7" maxlength="4000" required></textarea></label>
  <div class="trap" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off"></label></div>
  <button type="submit">Send message</button>
  <p id="contact-status" role="status" aria-live="polite"></p>
</form>
<p>Prefer a call? <a href="/book/schedule">Pick a time</a>. You can also try <a href="mailto:hello@finopsllm.com">hello@finopsllm.com</a>.</p>
<p>Agents can use <a href="/openapi.json">the documented JSON endpoint</a> with the user's permission.</p>
<p><a href="/">Back to FinOps LLM</a></p>
{% endblock %}
