  color: #e6edf3;
}

.results-table .cheapest {
  color: #5eead4;
  font-weight: 600;
}

.results-table .expensive {
  color: #f85149;
}

.summary {
  margin-top: 20px;
  padding: 20px;
  background: #161b22;
