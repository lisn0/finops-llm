<script>
// Same source as the pricing tracker: src/_data/pricing.json baked in at build
// time, then replaced by /api/pricing if the Worker has a valid fresher copy.
const PROVIDER_NAMES = { anthropic: "Anthropic", openai: "OpenAI", google: "Google", xai: "xAI", deepseek: "DeepSeek" };
let MODELS = [];

function loadPricing(data) {
  const ok = v => typeof v === "number" && isFinite(v) && v >= 0;
  const models = [];
  Object.keys(PROVIDER_NAMES).forEach(key => {
    (Array.isArray(data[key]) ? data[key] : []).forEach(m => {
      if (!m || !ok(m.input) || !ok(m.output)) return;
      models.push({
        // OpenAI entries carry raw ids ("gpt-6-sol"); render them as "GPT-6 Sol".
        name: String(m.model).replace(/^gpt-([\d.]+)-?(.*)$/, (_, v, rest) =>
          "GPT-" + v + rest.split("-").map(w => w ? " " + w[0].toUpperCase() + w.slice(1) : "").join("")),
        provider: PROVIDER_NAMES[key],
        inputPrice: m.input,
        outputPrice: m.output,
        cacheReadPrice: ok(m.cacheRead) ? m.cacheRead : m.input,
      });
    });
  });
  if (!models.length) return false;
  MODELS = models;
  if (data.updated) document.querySelectorAll("[data-live-updated]").forEach(el => { el.textContent = data.updated; });
  return true;
}

function costOf(model, inputTokens, outputTokens, cacheHitRate) {
  const cacheHitTokens = Math.round(inputTokens * (cacheHitRate / 100));
  return ((inputTokens - cacheHitTokens) * model.inputPrice + cacheHitTokens * model.cacheReadPrice + outputTokens * model.outputPrice) / 1000000;
}

function calculateCosts() {
  const inputTokens = parseInt(document.getElementById('inputTokens').value) || 0;
  const outputTokens = parseInt(document.getElementById('outputTokens').value) || 0;
  const requestsPerDay = parseInt(document.getElementById('requestsPerDay').value) || 0;
  const cacheHitRate = parseInt(document.getElementById('cacheHitRate').value) || 0;
  
  const results = MODELS.map(model => {
    const costPerRequest = costOf(model, inputTokens, outputTokens, cacheHitRate);
    const costPer1K = costPerRequest * 1000;
    const dailyCost = costPerRequest * requestsPerDay;
    const monthlyCost = dailyCost * 30;
    
    return {
      ...model,
      costPerRequest,
      costPer1K,
      dailyCost,
      monthlyCost
    };
  });
  
  // Sort by monthly cost
  results.sort((a, b) => a.monthlyCost - b.monthlyCost);
  
  // Find cheapest
  const cheapest = results[0]?.monthlyCost || 1;
  
  // Render table
  const tbody = document.getElementById('resultsBody');
  tbody.innerHTML = results.map((r, i) => {
    const vsCheapest = ((r.monthlyCost / cheapest - 1) * 100).toFixed(0);
    const isCheapest = i === 0;
    const isExpensive = i >= results.length - 3;
    
    return `
      <tr>
        <td><strong>${r.name}</strong></td>
        <td>${r.provider}</td>
        <td>$${r.costPer1K.toFixed(2)}</td>
        <td>$${r.dailyCost.toFixed(2)}</td>
        <td class="${isCheapest ? 'cheapest' : isExpensive ? 'expensive' : ''}">$${r.monthlyCost.toFixed(0)}</td>
        <td>${isCheapest ? '—' : `+${vsCheapest}%`}</td>
      </tr>
    `;
  }).join('');
  
  // Render summary
  const summary = document.getElementById('summary');
  const best = results[0];
  const worst = results[results.length - 1];
  const savings = worst.monthlyCost - best.monthlyCost;
  const cacheSaving = costOf(best, inputTokens, outputTokens, 0) * requestsPerDay * 30 - best.monthlyCost;

  summary.innerHTML = `
    <strong>Best option:</strong> ${best.name} (${best.provider}) at $${best.monthlyCost.toFixed(0)}/month.<br>
    <strong>Worst option:</strong> ${worst.name} (${worst.provider}) at $${worst.monthlyCost.toFixed(0)}/month.<br>
    <strong>Spread:</strong> $${savings.toFixed(0)}/month (${((worst.monthlyCost / best.monthlyCost - 1) * 100).toFixed(0)}% more expensive).<br><br>
    <strong>With ${cacheHitRate}% caching:</strong> You save $${cacheSaving.toFixed(0)}/month vs no caching on the best model.
  `;
}

// Attach listeners
document.querySelectorAll('input').forEach(input => {
  input.addEventListener('input', calculateCosts);
});

loadPricing({{ pricing | dump | safe }});
calculateCosts();
fetch('/api/pricing')
  .then(r => r.ok ? r.json() : null)
  .then(data => { if (data && loadPricing(data)) calculateCosts(); })
  .catch(() => { /* keep the build-time prices */ });
</script>

