{% extends "shell.njk" %}{% block body %}<div class="eye">FREE TOOL</div>
<h1 class="page-title">LLM Cost <em>Calculator.</em></h1>
<p class="lede">Compare costs across providers for your exact workload. Input your token usage, see real-time estimates for 20+ models.</p>

<div class="tool-container">
  <div class="input-section">
    <h2>Your workload</h2>
    
    <div class="input-group">
      <label for="inputTokens">Input tokens per request</label>
      <input type="number" id="inputTokens" value="4000" min="0">
      <span class="hint">System prompt + user message</span>
    </div>
    
    <div class="input-group">
      <label for="outputTokens">Output tokens per request</label>
      <input type="number" id="outputTokens" value="500" min="0">
      <span class="hint">Expected response length</span>
    </div>
    
    <div class="input-group">
      <label for="requestsPerDay">Requests per day</label>
      <input type="number" id="requestsPerDay" value="1000" min="1">
      <span class="hint">Daily volume</span>
    </div>
    
    <div class="input-group">
      <label for="cacheHitRate">Cache hit rate (%)</label>
      <input type="number" id="cacheHitRate" value="0" min="0" max="100">
      <span class="hint">0 = no caching, 70 = aggressive caching</span>
    </div>
  </div>
  
  <div class="results-section">
    <h2>Cost comparison</h2>
    <div class="results-table-container">
      <table class="results-table" id="resultsTable">
        <thead>
          <tr>
            <th>Model</th>
            <th>Provider</th>
            <th>Cost per 1K requests</th>
            <th>Daily cost</th>
            <th>Monthly cost</th>
            <th>vs cheapest</th>
          </tr>
        </thead>
        <tbody id="resultsBody">
          <!-- Populated by JS -->
        </tbody>
      </table>
    </div>
    
    <div class="summary" id="summary">
      <!-- Populated by JS -->
    </div>
  </div>
</div>

<div class="methodology">
  <h2>Methodology</h2>
  <p>Prices are per-model list prices as of August 2026. Cache-read tokens are discounted where applicable. Actual costs vary based on retries, latency requirements, and volume discounts.</p>
  <p>This calculator is for estimation only. For a precise audit of your actual spend, <a href="/book">book a free audit</a>.</p>
</div>

<style>
/* These pages were copied from llmcfo, whose page.css defines .wrap/.eye/
   .page-title/.lede/.back globally. finops has no such stylesheet, so the
   markup rendered unstyled and full-bleed. */
.wrap{max-width:1100px;margin:0 auto;padding:56px 24px}
.eye{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:12px;letter-spacing:.08em;color:#7AAFFF;margin:0 0 14px}
.page-title{font-size:clamp(30px,5vw,44px);line-height:1.08;margin:0 0 12px;color:#E6EAF2}
.lede{font-size:18px;color:#B6C0D2;max-width:62ch;margin:0 0 8px}
.back{display:inline-block;margin-top:40px;color:#7AAFFF;text-decoration:none}
.tool-container {
  display: grid;
  grid-template-columns: 1fr 2fr;
  gap: 40px;
  margin: 40px 0;
}

@media (max-width: 900px) {
  .tool-container {
    grid-template-columns: 1fr;
  }
}

.input-section {
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 12px;
  padding: 24px;
  height: fit-content;
}

.input-section h2 {
  font-size: 18px;
  margin-bottom: 20px;
  color: #e6edf3;
}

.input-group {
  margin-bottom: 20px;
}

.input-group label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  color: #8b949e;
  margin-bottom: 6px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.input-group input {
  width: 100%;
  padding: 10px 12px;
  background: #0d1117;
  border: 1px solid #30363d;
  border-radius: 6px;
  color: #e6edf3;
  font-size: 16px;
}

.input-group input:focus {
  outline: none;
  border-color: #5eead4;
}

.hint {
  display: block;
  font-size: 12px;
  color: #6e7681;
  margin-top: 4px;
}

.results-section h2 {
  font-size: 18px;
  margin-bottom: 20px;
  color: #e6edf3;
}

.results-table-container {
  overflow-x: auto;
  border: 1px solid #21262d;
  border-radius: 12px;
}

.results-table {
  width: 100%;
  border-collapse: collapse;
