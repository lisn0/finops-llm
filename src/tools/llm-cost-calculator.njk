  color: #8b949e;
}

.summary strong {
  color: #e6edf3;
}

.methodology {
  margin-top: 60px;
  padding-top: 40px;
  border-top: 1px solid #21262d;
  color: #8b949e;
  font-size: 14px;
}

.methodology h2 {
  color: #e6edf3;
  font-size: 18px;
  margin-bottom: 12px;
}
</style>

<script>
const MODELS = [
  { name: "GPT-4o", provider: "OpenAI", inputPrice: 2.50, outputPrice: 10.00, cacheReadPrice: 1.25 },
  { name: "GPT-4o mini", provider: "OpenAI", inputPrice: 0.15, outputPrice: 0.60, cacheReadPrice: 0.075 },
  { name: "o3", provider: "OpenAI", inputPrice: 10.00, outputPrice: 40.00, cacheReadPrice: 5.00 },
  { name: "o3-mini", provider: "OpenAI", inputPrice: 1.10, outputPrice: 4.40, cacheReadPrice: 0.55 },
  { name: "Claude Sonnet 4", provider: "Anthropic", inputPrice: 3.00, outputPrice: 15.00, cacheReadPrice: 0.30 },
  { name: "Claude Haiku 4", provider: "Anthropic", inputPrice: 0.80, outputPrice: 4.00, cacheReadPrice: 0.08 },
  { name: "Claude Opus 4", provider: "Anthropic", inputPrice: 15.00, outputPrice: 75.00, cacheReadPrice: 1.50 },
  { name: "Gemini 2.5 Pro", provider: "Google", inputPrice: 1.25, outputPrice: 10.00, cacheReadPrice: 0.31 },
  { name: "Gemini 2.5 Flash", provider: "Google", inputPrice: 0.30, outputPrice: 2.50, cacheReadPrice: 0.075 },
  { name: "Gemini 2.0 Flash", provider: "Google", inputPrice: 0.10, outputPrice: 0.40, cacheReadPrice: 0.025 },
  { name: "Llama 3.3 70B", provider: "Meta", inputPrice: 0.60, outputPrice: 0.60, cacheReadPrice: 0.60 },
  { name: "Mistral Large 2", provider: "Mistral", inputPrice: 2.00, outputPrice: 6.00, cacheReadPrice: 1.00 },
  { name: "DeepSeek V3", provider: "DeepSeek", inputPrice: 0.27, outputPrice: 1.10, cacheReadPrice: 0.07 },
  { name: "Command R+", provider: "Cohere", inputPrice: 2.50, outputPrice: 10.00, cacheReadPrice: 1.25 },
];

function calculateCosts() {
  const inputTokens = parseInt(document.getElementById('inputTokens').value) || 0;
  const outputTokens = parseInt(document.getElementById('outputTokens').value) || 0;
  const requestsPerDay = parseInt(document.getElementById('requestsPerDay').value) || 0;
  const cacheHitRate = parseInt(document.getElementById('cacheHitRate').value) || 0;
  
  const results = MODELS.map(model => {
    // Calculate cache splits
    const cacheHitTokens = Math.round(inputTokens * (cacheHitRate / 100));
    const cacheMissTokens = inputTokens - cacheHitTokens;
    
    // Cost per request
    const inputCost = (cacheMissTokens * model.inputPrice / 1000000) + 
                      (cacheHitTokens * model.cacheReadPrice / 1000000);
    const outputCost = outputTokens * model.outputPrice / 1000000;
    const costPerRequest = inputCost + outputCost;
    
    const costPer1K = costPerRequest * 1000;
    const dailyCost = costPerRequest * requestsPerDay;
    const monthlyCost = dailyCost * 30;
    
    return {
      ...model,
      costPerRequest,
      costPer1K,
      dailyCost,
      monthlyCost
    };
  });
  
  // Sort by monthly cost
  results.sort((a, b) => a.monthlyCost - b.monthlyCost);
  
  // Find cheapest
  const cheapest = results[0]?.monthlyCost || 1;
  
  // Render table
  const tbody = document.getElementById('resultsBody');
  tbody.innerHTML = results.map((r, i) => {
    const vsCheapest = ((r.monthlyCost / cheapest - 1) * 100).toFixed(0);
    const isCheapest = i === 0;
    const isExpensive = i >= results.length - 3;
    
    return `
      <tr>
        <td><strong>${r.name}</strong></td>
        <td>${r.provider}</td>
        <td>$${r.costPer1K.toFixed(2)}</td>
        <td>$${r.dailyCost.toFixed(2)}</td>
        <td class="${isCheapest ? 'cheapest' : isExpensive ? 'expensive' : ''}">$${r.monthlyCost.toFixed(0)}</td>
        <td>${isCheapest ? '—' : `+${vsCheapest}%`}</td>
      </tr>
    `;
  }).join('');
  
  // Render summary
  const summary = document.getElementById('summary');
  const best = results[0];
  const worst = results[results.length - 1];
  const savings = worst.monthlyCost - best.monthlyCost;
  
  summary.innerHTML = `
    <strong>Best option:</strong> ${best.name} (${best.provider}) at $${best.monthlyCost.toFixed(0)}/month.<br>
    <strong>Worst option:</strong> ${worst.name} (${worst.provider}) at $${worst.monthlyCost.toFixed(0)}/month.<br>
    <strong>Spread:</strong> $${savings.toFixed(0)}/month (${((worst.monthlyCost / best.monthlyCost - 1) * 100).toFixed(0)}% more expensive).<br><br>
    <strong>With ${cacheHitRate}% caching:</strong> You save approximately $${(best.monthlyCost * (1 - cacheHitRate / 200)).toFixed(0)}/month vs no caching on the best model.
  `;
}

// Attach listeners
document.querySelectorAll('input').forEach(input => {
  input.addEventListener('input', calculateCosts);
});

// Initial calculation
calculateCosts();
</script>

