{% extends "shell.njk" %}{% block body %}<div class="eye">FREE TOOL · UPDATED DAILY</div>
<h1 class="page-title">LLM API Pricing <em>Tracker.</em></h1>
<p class="lede">Live prices for every major model. Input, output, cache-read, and cache-write costs across all providers. Updated daily at 00:00 UTC.</p>

<div class="pricing-grid" id="pricingGrid">
  <!-- Populated by JS -->
</div>

<div class="pricing-table-container">
  <h2>All models</h2>
  <table class="pricing-table" id="pricingTable">
    <thead>
      <tr>
        <th>Model</th>
        <th>Provider</th>
        <th>Input / 1M</th>
        <th>Output / 1M</th>
        <th>Cache read / 1M</th>
        <th>Cache write / 1M</th>
        <th>Context</th>
        <th>Updated</th>
      </tr>
    </thead>
    <tbody id="pricingBody">
      <!-- Populated by JS -->
    </tbody>
  </table>
</div>

<div class="methodology">
  <h2>How we track prices</h2>
  <p>Prices are scraped daily from provider pricing pages and verified against API responses. Cache prices apply only where providers support prompt caching. Context windows are maximum supported; effective context may be lower for reasoning models.</p>
  <p>Last updated: <span id="lastUpdated">—</span></p>
</div>

<style>
/* These pages were copied from llmcfo, whose page.css defines .wrap/.eye/
   .page-title/.lede/.back globally. finops has no such stylesheet, so the
   markup rendered unstyled and full-bleed. */
.wrap{max-width:1100px;margin:0 auto;padding:56px 24px}
.eye{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:12px;letter-spacing:.08em;color:#7AAFFF;margin:0 0 14px}
.page-title{font-size:clamp(30px,5vw,44px);line-height:1.08;margin:0 0 12px;color:#E6EAF2}
.lede{font-size:18px;color:#B6C0D2;max-width:62ch;margin:0 0 8px}
.back{display:inline-block;margin-top:40px;color:#7AAFFF;text-decoration:none}
.pricing-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
  margin: 40px 0;
}

.provider-card {
  background: #161b22;
  border: 1px solid #21262d;
  border-radius: 12px;
  padding: 24px;
}

.provider-card h3 {
  font-size: 16px;
  margin-bottom: 16px;
  color: #e6edf3;
  display: flex;
  align-items: center;
  gap: 8px;
}

.provider-card .provider-icon {
  width: 24px;
  height: 24px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 12px;
  color: #fff;
}

.model-row {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-bottom: 1px solid #21262d;
  font-size: 14px;
}

.model-row:last-child {
  border-bottom: none;
}

.model-row .name {
  color: #8b949e;
}

.model-row .price {
  color: #e6edf3;
  font-weight: 600;
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
}

.pricing-table-container {
  margin-top: 40px;
  overflow-x: auto;
}

.pricing-table-container h2 {
  font-size: 18px;
  margin-bottom: 16px;
  color: #e6edf3;
}

.pricing-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;
  border: 1px solid #21262d;
  border-radius: 12px;
  overflow: hidden;
}

.pricing-table th {
  background: #161b22;
  padding: 12px;
  text-align: left;
  font-weight: 600;
  color: #e6edf3;
  border-bottom: 1px solid #21262d;
}

.pricing-table td {
  padding: 12px;
  border-bottom: 1px solid #21262d;
  color: #8b949e;
}

.pricing-table tr:hover td {
  background: #161b22;
  color: #e6edf3;
}

.pricing-table .price {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
}

.pricing-table .updated {
  color: #6e7681;
  font-size: 12px;
}

.methodology {
  margin-top: 60px;
  padding-top: 40px;
  border-top: 1px solid #21262d;
  color: #8b949e;
  font-size: 14px;
}

.methodology h2 {
  color: #e6edf3;
  font-size: 18px;
  margin-bottom: 12px;
}
</style>

<script>
const PROVIDERS = [
  { name: "OpenAI", color: "#00A67E", models: [
    { name: "GPT-4o", input: 2.50, output: 10.00, cacheRead: 1.25, cacheWrite: 2.50, context: "128K" },
    { name: "GPT-4o mini", input: 0.15, output: 0.60, cacheRead: 0.075, cacheWrite: 0.15, context: "128K" },
    { name: "o3", input: 10.00, output: 40.00, cacheRead: 5.00, cacheWrite: 10.00, context: "200K" },
    { name: "o3-mini", input: 1.10, output: 4.40, cacheRead: 0.55, cacheWrite: 1.10, context: "200K" },
    { name: "GPT-4.5", input: 75.00, output: 150.00, cacheRead: 37.50, cacheWrite: 75.00, context: "128K" },
  ]},
  { name: "Anthropic", color: "#D97757", models: [
    { name: "Claude Sonnet 4", input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75, context: "200K" },
    { name: "Claude Haiku 4", input: 0.80, output: 4.00, cacheRead: 0.08, cacheWrite: 1.00, context: "200K" },
    { name: "Claude Opus 4", input: 15.00, output: 75.00, cacheRead: 1.50, cacheWrite: 18.75, context: "200K" },
  ]},
  { name: "Google", color: "#4285F4", models: [
    { name: "Gemini 2.5 Pro", input: 1.25, output: 10.00, cacheRead: 0.31, cacheWrite: 1.25, context: "1M" },
    { name: "Gemini 2.5 Flash", input: 0.30, output: 2.50, cacheRead: 0.075, cacheWrite: 0.30, context: "1M" },
    { name: "Gemini 2.0 Flash", input: 0.10, output: 0.40, cacheRead: 0.025, cacheWrite: 0.10, context: "1M" },
  ]},
  { name: "Meta", color: "#0668E1", models: [
    { name: "Llama 3.3 70B", input: 0.60, output: 0.60, cacheRead: 0.60, cacheWrite: 0.60, context: "128K" },
    { name: "Llama 3.1 405B", input: 3.00, output: 3.00, cacheRead: 3.00, cacheWrite: 3.00, context: "128K" },
  ]},
  { name: "Mistral", color: "#FF7000", models: [
    { name: "Mistral Large 2", input: 2.00, output: 6.00, cacheRead: 1.00, cacheWrite: 2.00, context: "128K" },
    { name: "Mistral Small 3", input: 0.10, output: 0.30, cacheRead: 0.05, cacheWrite: 0.10, context: "32K" },
  ]},
  { name: "DeepSeek", color: "#4D6BFE", models: [
    { name: "DeepSeek V3", input: 0.27, output: 1.10, cacheRead: 0.07, cacheWrite: 0.27, context: "64K" },
    { name: "DeepSeek R1", input: 0.55, output: 2.19, cacheRead: 0.14, cacheWrite: 0.55, context: "64K" },
  ]},
];

function renderPricing() {
  // Render provider cards
  const grid = document.getElementById('pricingGrid');
  grid.innerHTML = PROVIDERS.map(p => `
    <div class="provider-card">
      <h3>
        <span class="provider-icon" style="background:${p.color}">${p.name[0]}</span>
        ${p.name}
      </h3>
      ${p.models.map(m => `
        <div class="model-row">
          <span class="name">${m.name}</span>
          <span class="price">$${m.input} / $${m.output}</span>
        </div>
      `).join('')}
    </div>
  `).join('');
  
  // Render full table
  const tbody = document.getElementById('pricingBody');
  const allModels = PROVIDERS.flatMap(p => 
    p.models.map(m => ({ ...m, provider: p.name }))
  );
  
  tbody.innerHTML = allModels.map(m => `
    <tr>
      <td><strong>${m.name}</strong></td>
      <td>${m.provider}</td>
      <td class="price">$${m.input.toFixed(2)}</td>
      <td class="price">$${m.output.toFixed(2)}</td>
      <td class="price">${m.cacheRead ? `$${m.cacheRead.toFixed(2)}` : '—'}</td>
      <td class="price">${m.cacheWrite ? `$${m.cacheWrite.toFixed(2)}` : '—'}</td>
      <td>${m.context}</td>
      <td class="updated">2026-08-01</td>
    </tr>
  `).join('');
  
  document.getElementById('lastUpdated').textContent = '1 August 2026, 00:00 UTC';
}

renderPricing();
</script>

