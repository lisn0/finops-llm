  color: #e6edf3;
  font-size: 18px;
  margin-bottom: 12px;
}
</style>

<script>
let UPDATED = "2026-09-02";
const PROVIDERS = [
  { name: "OpenAI", color: "#00A67E", models: [
    { id: "gpt-5-6-sol", name: "GPT-5.6-Sol", input: 4.00, output: 20.00, cacheRead: 0.40, cacheWrite: 5.00, context: "1.05M" },
    { id: "gpt-5-6-terra", name: "GPT-5.6-Terra", input: 2.00, output: 12.00, cacheRead: 0.20, cacheWrite: 2.50, context: "1.05M" },
    { id: "gpt-5-6-luna", name: "GPT-5.6-Luna", input: 0.20, output: 1.20, cacheRead: 0.02, cacheWrite: 0.25, context: "1.05M" },
  ]},
  { name: "Anthropic", color: "#D97757", models: [
    { id: "fable-5-1", name: "Claude Fable 5.1", input: 10.00, output: 50.00, cacheRead: 0.25, cacheWrite: 12.50, context: "1M" },
    { id: "fable-5", name: "Claude Fable 5", input: 10.00, output: 50.00, cacheRead: 1.00, cacheWrite: 12.50, context: "1M" },
    { id: "opus-5", name: "Claude Opus 5", input: 5.00, output: 25.00, cacheRead: 0.50, cacheWrite: 6.25, context: "1M" },
    { id: "sonnet-5", name: "Claude Sonnet 5", input: 2.00, output: 10.00, cacheRead: 0.20, cacheWrite: 2.50, context: "1M" },
    { id: "sonnet-4-6", name: "Claude Sonnet 4.6", input: 3.00, output: 15.00, cacheRead: 0.30, cacheWrite: 3.75, context: "1M" },
    { id: "haiku-4-5", name: "Claude Haiku 4.5", input: 1.00, output: 5.00, cacheRead: 0.10, cacheWrite: 1.25, context: "200K" },
  ]},
  { name: "Google", color: "#4285F4", models: [
    { name: "Gemini 2.5 Pro", input: 1.25, output: 10.00, cacheRead: 0.31, cacheWrite: 1.25, context: "1M" },
    { name: "Gemini 2.5 Flash", input: 0.30, output: 2.50, cacheRead: 0.075, cacheWrite: 0.30, context: "1M" },
    { name: "Gemini 2.0 Flash", input: 0.10, output: 0.40, cacheRead: 0.025, cacheWrite: 0.10, context: "1M" },
  ]},
  { name: "Meta", color: "#0668E1", models: [
    { name: "Llama 3.3 70B", input: 0.60, output: 0.60, cacheRead: 0.60, cacheWrite: 0.60, context: "128K" },
    { name: "Llama 3.1 405B", input: 3.00, output: 3.00, cacheRead: 3.00, cacheWrite: 3.00, context: "128K" },
  ]},
  { name: "Mistral", color: "#FF7000", models: [
    { name: "Mistral Large 2", input: 2.00, output: 6.00, cacheRead: 1.00, cacheWrite: 2.00, context: "128K" },
    { name: "Mistral Small 3", input: 0.10, output: 0.30, cacheRead: 0.05, cacheWrite: 0.10, context: "32K" },
  ]},
  { name: "DeepSeek", color: "#4D6BFE", models: [
    { name: "DeepSeek V3", input: 0.27, output: 1.10, cacheRead: 0.07, cacheWrite: 0.27, context: "64K" },
    { name: "DeepSeek R1", input: 0.55, output: 2.19, cacheRead: 0.14, cacheWrite: 0.55, context: "64K" },
  ]},
];

function renderPricing() {
  // Render provider cards
  const grid = document.getElementById('pricingGrid');
  grid.innerHTML = PROVIDERS.map(p => `
    <div class="provider-card">
      <h3>
        <span class="provider-icon" style="background:${p.color}">${p.name[0]}</span>
        ${p.name}
      </h3>
      ${p.models.map(m => `
        <div class="model-row">
          <span class="name">${m.name}</span>
          <span class="price">$${m.input} / $${m.output}</span>
        </div>
      `).join('')}
    </div>
  `).join('');
  
  // Render full table
  const tbody = document.getElementById('pricingBody');
  const allModels = PROVIDERS.flatMap(p => 
    p.models.map(m => ({ ...m, provider: p.name }))
  );
  
  tbody.innerHTML = allModels.map(m => `
    <tr>
      <td><strong>${m.name}</strong></td>
      <td>${m.provider}</td>
      <td class="price">$${m.input.toFixed(2)}</td>
      <td class="price">$${m.output.toFixed(2)}</td>
      <td class="price">${m.cacheRead ? `$${m.cacheRead.toFixed(2)}` : '—'}</td>
      <td class="price">${m.cacheWrite ? `$${m.cacheWrite.toFixed(2)}` : '—'}</td>
      <td>${m.context}</td>
      <td class="updated">${UPDATED}</td>
    </tr>
  `).join('');
  
  document.getElementById('lastUpdated').textContent = UPDATED;
}

renderPricing();

// Live refresh: the worker re-reads each provider's published pricing page
// behind the edge cache. Any failure or malformed payload leaves the baked-in
// table exactly as rendered above.
fetch('/api/pricing').then(r => r.ok ? r.json() : null).then(d => {
  if (!d) return;
  let changed = false;
  PROVIDERS.forEach(p => {
    const live = d[p.name.toLowerCase()];
    if (!Array.isArray(live) || live.length !== p.models.length) return;
    p.models = live.map(m => ({
      id: m.id, name: m.model, input: m.input, output: m.output,
      cacheRead: m.cacheRead, cacheWrite: m.cacheWrite5m,
      context: m.context >= 1e6 ? +(m.context / 1e6).toFixed(2) + 'M' : (m.context / 1000) + 'K',
    }));
    changed = true;
  });
  if (!changed) return;
  if (d.updated) UPDATED = d.updated;
  renderPricing();
}).catch(() => {});
</script>

